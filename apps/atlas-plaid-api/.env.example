# Atlas Plaid API — local environment template
# Copy to .secrets/plaid.env (gitignored). NEVER commit real values.

PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_WEBHOOK_URL=
PLAID_API_PORT=8787
PLAID_REQUIRE_AUTH=true
PLAID_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5173,http://localhost:5173
PLAID_DATA_DIR=

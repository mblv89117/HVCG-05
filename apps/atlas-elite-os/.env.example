# Copy to apps/atlas-elite-os/.env.local for local Microsoft Dev wiring.
# Never commit secrets. Client IDs are public; do not put client secrets in a SPA.

VITE_ATLAS_ENV=local
VITE_ENTRA_TENANT_ID=3df46563-86f3-4414-87fd-84ba967741ef
VITE_ENTRA_CLIENT_ID=
VITE_REDIRECT_URI=http://127.0.0.1:5180
VITE_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5180
VITE_DATAVERSE_URL=https://org1131a2b0.crm.dynamics.com
VITE_DATAVERSE_API_VERSION=v9.2
VITE_GRAPH_URL=https://graph.microsoft.com/v1.0
VITE_SHAREPOINT_SITE_URL=
VITE_POWER_AUTOMATE_BASE_URL=
VITE_HOSTED_APP_URL=
VITE_ALLOW_SAMPLE_FALLBACK=true
VITE_BLOCK_LIVE_CLIENT_COMMS=true

# Product role (Dev/UAT). Prefer Entra group mapping in production.
# Values: HVCG Owner | HVCG Team Member | Client Executive | Client Team Member | Read-Only Advisor | Administrator
VITE_ATLAS_ROLE=HVCG Owner
# Set true only for local role simulation (bypasses Graph group resolution)
VITE_ATLAS_ROLE_FORCE=false

# Entra security group object IDs (public directory IDs — not secrets)
VITE_ENTRA_GROUP_HVCG_OWNER=
VITE_ENTRA_GROUP_ADMINISTRATOR=
VITE_ENTRA_GROUP_HVCG_TEAM=
VITE_ENTRA_GROUP_CLIENT_EXECUTIVE=
VITE_ENTRA_GROUP_CLIENT_TEAM=
VITE_ENTRA_GROUP_READ_ONLY_ADVISOR=

# Copy to apps/atlas-elite-os/.env.local for local Microsoft Dev wiring.
# Never commit secrets. Client IDs are public; do not put client secrets in a SPA.

VITE_ATLAS_ENV=local
VITE_ENTRA_TENANT_ID=3df46563-86f3-4414-87fd-84ba967741ef
VITE_ENTRA_CLIENT_ID=
VITE_REDIRECT_URI=http://127.0.0.1:5180
VITE_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5180
VITE_DATAVERSE_URL=https://org1131a2b0.crm.dynamics.com
VITE_DATAVERSE_API_VERSION=v9.2
VITE_GRAPH_URL=https://graph.microsoft.com/v1.0
VITE_SHAREPOINT_SITE_URL=
VITE_POWER_AUTOMATE_BASE_URL=
VITE_HOSTED_APP_URL=
VITE_ALLOW_SAMPLE_FALLBACK=true
VITE_BLOCK_LIVE_CLIENT_COMMS=true

# --- Local Owner UAT (DEV ONLY) ---
# Explicit button: "Local Owner (Dev)". Hard-disabled when VITE_ATLAS_ENV=production|staging.
# Does NOT auto-grant Owner on page load. Never enable in production builds.
VITE_ALLOW_DEV_OWNER_LOGIN=true
# Optional override (default HVCG Owner). Administrator is also valid for full admin matrix.
VITE_DEV_OWNER_ROLE=HVCG Owner

# QA role simulation for signed-in Entra users WITHOUT app roles (non-production only).
# Never defaults to Owner. Valid: HVCG Owner | HVCG Team Member | Client Executive |
# Client Team Member | Read-Only Advisor | Administrator
VITE_ALLOW_ROLE_SIM=false
VITE_ATLAS_ROLE_SIM=

# Universal Integration Hub API (Microsoft / Google / GitHub connectors)
VITE_INTEGRATION_API_BASE=http://127.0.0.1:8790

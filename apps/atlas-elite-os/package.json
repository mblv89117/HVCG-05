{
  "name": "@hvcg/atlas-elite-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc -b && vite build",
    "lint": "eslint src --max-warnings 200",
    "lint:hooks": "eslint src --quiet --rule 'react-hooks/rules-of-hooks: error'",
    "test:recovery": "node ./scripts/recovery-tests.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "test:routes": "node ./scripts/project-route-tests.mjs",
    "test:hub-auth": "node ./scripts/hub-access-token-tests.mjs",
    "test:hard-refresh": "node ./scripts/hard-refresh-shell-test.mjs",
    "test:auth-transitions": "node ./scripts/auth-transition-tests.mjs",
    "test:all": "npm run test:hub-auth && npm run test:routes && npm run test:recovery && npm run test:hard-refresh && npm run test:auth-transitions && npm run test:hook-order && npm run test:operating-data",
    "test:hook-order": "node ./scripts/hook-order-render-tests.mjs",
    "test:operating-data": "node ./scripts/operating-data-quality-tests.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.12.0",
    "@fluentui/react-components": "^9.72.3",
    "@fluentui/react-icons": "^2.0.311",
    "@hvcg/atlas-design-system": "*",
    "@hvcg/atlas-plaid-contracts": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5"
  }
}

# Atlas Universal Integration Hub API — local environment template
# Copy to .secrets/integration.env (gitignored). NEVER commit real values.

# Server
INTEGRATION_API_PORT=8790
INTEGRATION_REQUIRE_AUTH=false
INTEGRATION_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5173,http://localhost:5173,https://zealous-rock-0090c7e1e.7.azurestaticapps.net
INTEGRATION_DATA_DIR=
PUBLIC_BASE_URL=http://localhost:8790

# Token encryption (32-byte base64) — required unless ephemeral dev key allowed
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_ALLOW_EPHEMERAL_KEY=1

# Microsoft Entra / Graph (read-only delegated)
# Redirect MUST use http://localhost (Entra rejects http://127.0.0.1)
# Multi-company (HVCG + HVS): set Entra app to multi-tenant, then:
MICROSOFT_AUTH_TENANT=organizations
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8790/api/oauth/microsoft/callback

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub App + OAuth (owner must install App on org/repos for installation tokens)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=

# Local AI Operations Phase 1/2 — ALL write/comms flags default Off.
LOCAL_AI_ENABLED=false
LOCAL_AI_WRITES_ENABLED=false
LOCAL_AI_EXTERNAL_MESSAGES_ENABLED=false
EVA_INTAKE_ENABLED=false
CLIENT_EMAILS_ENABLED=false
LOCAL_AI_KILL_SWITCH=false
# Executor: mock (default) or ollama (Phase 2 local Dev after tests)
LOCAL_AI_EXECUTOR=mock
# Prefer .secrets/local-ai.env (gitignored) for machine-specific model selection
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_RETRIES=1
OLLAMA_ALLOW_NON_LOOPBACK=false
OLLAMA_FORMAT_JSON=true

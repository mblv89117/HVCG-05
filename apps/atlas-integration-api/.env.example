# Atlas Universal Integration Hub API — local environment template
# Copy to .secrets/integration.env (gitignored). NEVER commit real values.

# Server
INTEGRATION_API_PORT=8790
# Default bind is loopback. Production containers may set INTEGRATION_HOST=0.0.0.0
# only while authentication remains enforced (the default).
INTEGRATION_HOST=127.0.0.1
# Authentication is ON by default in every environment, including development.
# INTEGRATION_REQUIRE_AUTH=false is rejected unless insecure-dev opt-in is also set,
# and is never allowed when NODE_ENV=production.
INTEGRATION_REQUIRE_AUTH=true
# Explicit local-only anonymous Hub. Requires loopback bind. Forbidden in production.
INTEGRATION_ALLOW_INSECURE_DEV_AUTH=false
# NODE_ENV=production disables connector mixed-content search and sync
# (CONNECTOR_SEARCH_DISABLED_IN_PRODUCTION / CONNECTOR_SYNC_DISABLED_IN_PRODUCTION).
# There is no override flag. Connection ownership still applies in every environment.
INTEGRATION_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5173,http://localhost:5173,https://zealous-rock-0090c7e1e.7.azurestaticapps.net
INTEGRATION_DATA_DIR=
PUBLIC_BASE_URL=http://localhost:8790

# PM persistence. pm-store.json is development/local state only — not SharePoint,
# not production, and not an approved operational system of record.
# Unset or `unavailable`: Hub starts; /api/pm/* that need persistence return 503
# PM_BACKEND_UNAVAILABLE. There is no JSON fallback.
# `development-json` (alias `local-json`): explicit local JSON, non-production only.
# Production plus development-json is rejected at startup (fail closed).
# `sharepoint`: production Graph repository. Requires explicit site/list GUIDs and
# AZURE_CLIENT_ID (user-assigned managed identity). Never falls back to JSON.
# Do not put production GUIDs in committed files; set them in the runtime environment.
# App Service injects IDENTITY_ENDPOINT and IDENTITY_HEADER for the local token
# endpoint. Do not set those as application settings. Do not use VM IMDS.
INTEGRATION_PM_BACKEND=unavailable
# INTEGRATION_PM_SHAREPOINT_SITE_ID=
# INTEGRATION_PM_PROJECTS_LIST_ID=
# INTEGRATION_PM_TASKS_LIST_ID=
# INTEGRATION_PM_MILESTONES_LIST_ID=
# INTEGRATION_PM_CLIENTS_LIST_ID=
# AZURE_CLIENT_ID=

# Token encryption (32-byte base64) — required unless ephemeral dev key allowed
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_ALLOW_EPHEMERAL_KEY=1

# Microsoft Entra / Graph (read-only delegated)
# Redirect MUST use http://localhost (Entra rejects http://127.0.0.1)
# Multi-company (HVCG + HVS): set Entra app to multi-tenant, then:
MICROSOFT_AUTH_TENANT=organizations
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8790/api/oauth/microsoft/callback

# Staff client entitlement (Entra HVCG-Client-{ClientCode} groups).
# Server-side Graph lookup using the Hub confidential client. Never headers.
# Default ON. Missing oid/credentials/groups → empty allow-list (fail closed).
INTEGRATION_CLIENT_ENTITLEMENT_ENABLED=true
INTEGRATION_CLIENT_GROUP_PREFIX=HVCG-Client-
# Runtime map only (not committed customer roster): groupObjectId:ClientCode,...
# Duplicate group IDs, duplicate ClientCodes, malformed GUIDs, malformed codes,
# or '*' fail the entire map (empty allow-list). Last-write-wins is forbidden.
# Production deploy must verify this set against live HVCG_Clients.ClientCode.
# Empty map + entitlement enabled → fail closed (no bearer-only client access).
INTEGRATION_CLIENT_ENTITLEMENT_GROUPS=
# Derived in-process cache. 0 disables. Cap 300000.
INTEGRATION_CLIENT_ENTITLEMENT_CACHE_TTL_MS=120000
INTEGRATION_CLIENT_ENTITLEMENT_GRAPH_TIMEOUT_MS=3000

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub App + OAuth (owner must install App on org/repos for installation tokens)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=

# Optional Local AI adapter — ALL flags default Off.
# Atlas must boot with Ollama absent, models absent, and Local AI .data absent.
# Do not enable in production. Do not download models automatically.
LOCAL_AI_ENABLED=false
LOCAL_AI_WRITES_ENABLED=false
LOCAL_AI_EXTERNAL_MESSAGES_ENABLED=false
EVA_INTAKE_ENABLED=false
CLIENT_EMAILS_ENABLED=false
LOCAL_AI_KILL_SWITCH=false
# Loopback-only provider. Non-loopback URLs are rejected unless explicitly allowed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=120000
OLLAMA_ALLOW_NON_LOOPBACK=false
OLLAMA_FORMAT_JSON=true
# Optional gitignored overlay (never commit):
# LOCAL_AI_SECRETS_FILE=.secrets/local-ai.env

# Isolated Business Analyst HTTP service (Option A). Hub is the only public API.
# Unset: Hub starts; /api/ba/* returns 503 ba_not_configured. PM is unaffected.
# There is no production spawn("python3") fallback.
# INTEGRATION_BA_BASE_URL=
# INTEGRATION_BA_TIMEOUT_MS=15000
# INTEGRATION_BA_HEALTH_TIMEOUT_MS=800
# Local/test Hub→BA bearer only. Ignored in production. Future: managed identity.
# INTEGRATION_BA_S2S_TOKEN=
# ATLAS_ENV=development

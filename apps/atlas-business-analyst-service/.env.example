# Atlas Business Analyst service — local/test template.
# Copy values into the runtime environment. NEVER commit real secrets.
# Azure / Entra identifiers for the future BA API are NOT created in this gate.
# Leave identity fields empty until the infrastructure gate provisions them.

BA_ATLAS_ENV=local
BA_HOST=127.0.0.1
BA_PORT=8794

# Canonical engines (default: repository config/business). No workstation-absolute paths.
# HVCG_BA_BUSINESS_DIR=

# Production auth is required. These are placeholders — do not invent IDs.
BA_REQUIRE_AUTH=true
BA_ENTRA_TENANT_ID=
BA_API_AUDIENCE=
BA_AUTHORIZED_AZP=
# Optional override. Default: https://login.microsoftonline.com/{tenant}/discovery/v2.0/keys
# BA_JWKS_URL=

# Local/test only. Production refuses to start if any of these are set.
# BA_TEST_AUTH_TOKEN=
# BA_TEST_JWT_HS256_SECRET=

# Local AI remains off. QBO remains deferred. Production start fails if either is enabled.
LOCAL_AI_ENABLED=false
BA_QBO_ENABLED=false

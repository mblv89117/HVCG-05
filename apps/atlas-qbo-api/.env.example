# Atlas QuickBooks Online API — local environment template
# Copy to .secrets/qbo.env (gitignored). NEVER commit real values.
# Key Vault secret names (target):
#   qbo-client-id-sandbox
#   qbo-client-secret-sandbox
#   qbo-token-encryption-key
#   qbo-redirect-uri

QBO_ENV=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://127.0.0.1:8788/api/qbo/oauth/callback
QBO_TOKEN_ENCRYPTION_KEY=
QBO_API_PORT=8788
QBO_REQUIRE_AUTH=true
QBO_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5173,http://localhost:5173
QBO_DATA_DIR=
QBO_SYNC_INTERVAL_MS=900000
QBO_FRONTEND_SUCCESS_REDIRECT=http://127.0.0.1:5180/accounting
QBO_FRONTEND_ERROR_REDIRECT=http://127.0.0.1:5180/accounting

  "metrics": [
    {
      "id": "ATLAS-M-001",
      "name": "Revenue trend",
      "businessMeaning": "Collected revenue movement over time for growth/stall detection.",
      "formula": "SUM(AmountCollected) by calendar month; optional RecognizedAmount series",
      "dataSources": ["HVCG_Invoices", "HVCG_FinancialMilestones"],
      "refreshFrequency": "BI 4x/day Dev; Apps on refresh",
      "reportingPeriod": "Trailing 12 months (default)",
      "owner": "analytics",
      "limitations": "Not bank-synced; never zero-fill missing months with invented history",
      "filters": ["ClientCode", "InvoiceType", "period"],
      "security": "Owner/Admin/Finance",
      "visual": "line",
      "domains": ["executive", "revenue", "finance"],
      "aliases": []
    },
    {
      "id": "ATLAS-M-002",
      "name": "Weighted pipeline",
      "businessMeaning": "Probability-weighted open opportunity value.",
      "formula": "SUM(WeightedValue) WHERE WinLossStatus='Open'",
      "dataSources": ["HVCG_Opportunities"],
      "refreshFrequency": "Near real-time Apps; BI schedule",
      "reportingPeriod": "Point-in-time",
      "owner": "analytics",
      "limitations": "Depends on Probability/WeightedValue quality",
      "filters": ["Stage", "ForecastCategory", "SalesOwnerEmail", "ClientCode"],
      "security": "Owner+",
      "visual": "kpi-tile",
      "domains": ["executive", "revenue"],
      "aliases": ["KPI-01", "E-01"]
    },
    {
      "id": "ATLAS-M-003",
      "name": "Conversion rate",
      "businessMeaning": "Win rate of closed opportunities in last 90 days.",
      "formula": "Won / (Won + Lost) WHERE closed in last 90 days",
      "dataSources": ["HVCG_Opportunities", "HVCG_WinLossAnalyses"],
      "refreshFrequency": "Daily BI",
      "reportingPeriod": "Rolling 90 days",
      "owner": "analytics",
      "limitations": "Small-N noise; excludes open deals",
      "filters": ["SalesOwnerEmail"],
      "security": "Owner+",
      "visual": "kpi-pct",
      "domains": ["executive", "revenue"],
      "aliases": ["KPI-12"]
    },
    {

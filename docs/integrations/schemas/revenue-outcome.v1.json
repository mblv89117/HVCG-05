{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highvaluecapitalgroup.com/contracts/revenue-outcome.v1.json",
  "title": "Revenue Outcome v1",
  "description": "Closed commercial revenue outcome owned by Atlas finance/ops. Feeds learning only via ClosedWonLearningEvent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "outcomeId",
    "clientCode",
    "opportunityId",
    "amount",
    "currency",
    "closedAt"
  ],
  "properties": {
    "contractVersion": {
      "const": "revenue-outcome.v1"
    },
    "outcomeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "clientCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2,15}$"
    },
    "opportunityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "engagementId": {
      "type": "string",
      "maxLength": 255
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "outcomeType": {
      "type": "string",
      "enum": [
        "closed_won",
        "closed_lost",
        "expansion",
        "renewal",
        "churn"
      ]
    },
    "closedAt": {
      "type": "string",
      "format": "date-time"
    },
    "attribution": {
      "$ref": "./attribution-lineage.v1.json"
    }
  }
}

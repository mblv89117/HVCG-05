{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highvaluecapitalgroup.com/contracts/opportunity-commercial-context.v1.json",
  "title": "Opportunity Commercial Context v1",
  "description": "Atlas-owned commercial context for an HVCG_Opportunities record. Revenue OS may recommend; Atlas owns state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "opportunityId",
    "clientCode",
    "stage"
  ],
  "properties": {
    "contractVersion": {
      "const": "opportunity-commercial-context.v1"
    },
    "opportunityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "clientCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2,15}$"
    },
    "leadId": {
      "type": "string",
      "maxLength": 255
    },
    "stage": {
      "type": "string",
      "maxLength": 128
    },
    "ownerPrincipal": {
      "type": "string",
      "maxLength": 255
    },
    "estimatedValue": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "attribution": {
      "$ref": "./attribution-lineage.v1.json"
    },
    "etag": {
      "type": "string",
      "maxLength": 255
    }
  }
}

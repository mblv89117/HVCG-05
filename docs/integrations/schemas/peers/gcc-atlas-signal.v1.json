{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highvaluecapitalgroup.com/contracts/gcc-atlas-signal.v1.json",
  "title": "GCC Atlas Signal v1 (producer-local; map to gcc-value-signal.v1)",
  "description": "NON-CANONICAL producer shape observed on GCC tip. Canonical Atlas-bound signal is gcc-value-signal.v1. Use adapters/gcc-atlas-signal-to-value-signal mapping. Do not treat this as Integration SoT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "signalId",
    "kind",
    "clientCode",
    "engagementId",
    "gccOrganizationId",
    "emittedAt",
    "summary",
    "severity",
    "payload",
    "requiresAtlasAction",
    "capitalOpsEligible"
  ],
  "properties": {
    "contractVersion": {
      "const": "gcc-atlas-signal.v1"
    },
    "signalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "kind": {
      "type": "string",
      "enum": [
        "high_realized_value",
        "new_constraint",
        "new_capital_need",
        "new_ai_opportunity",
        "new_process_bottleneck",
        "contract_opportunity",
        "financial_deterioration",
        "low_engagement",
        "renewal_risk",
        "expansion_ready"
      ]
    },
    "clientCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2,15}$"
    },
    "engagementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "gccOrganizationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "emittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "severity": {
      "type": "string",
      "maxLength": 64
    },
    "payload": {
      "type": "object"
    },
    "requiresAtlasAction": {
      "type": "boolean"
    },
    "capitalOpsEligible": {
      "type": "boolean"
    }
  }
}

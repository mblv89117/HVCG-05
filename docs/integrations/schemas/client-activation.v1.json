{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highvaluecapitalgroup.com/contracts/client-activation.v1.json",
  "title": "Atlas Client Activation v1",
  "description": "Governed Opportunity Won → Active Client workflow. Does not provision Entra groups, SharePoint libraries, portal access, or entitlements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "opportunityId"],
  "properties": {
    "action": { "enum": ["request", "review", "authorize", "verify"] },
    "opportunityId": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "maxLength": 2000 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highvaluecapitalgroup.com/contracts/gcc-gtm-feedback.v1.json",
  "title": "GCC to GTM Feedback v1",
  "description": "Aggregated non-sensitive value signals for GTM learning. Excludes raw client financials. Canonical under Platform Integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "periodLabel",
    "serviceLine",
    "clientRetentionSignal",
    "expansionSignal",
    "engagementHealth",
    "valueRealization",
    "outcomeCategories",
    "sensitiveFinancialExcluded"
  ],
  "properties": {
    "contractVersion": {
      "const": "gcc-gtm-feedback.v1"
    },
    "periodLabel": {
      "type": "string",
      "maxLength": 128
    },
    "serviceLine": {
      "type": "string",
      "maxLength": 128
    },
    "clientRetentionSignal": {
      "enum": [
        "strong",
        "stable",
        "at_risk"
      ]
    },
    "expansionSignal": {
      "enum": [
        "ready",
        "watch",
        "none"
      ]
    },
    "engagementHealth": {
      "enum": [
        "healthy",
        "mixed",
        "weak"
      ]
    },
    "valueRealization": {
      "enum": [
        "high",
        "moderate",
        "low"
      ]
    },
    "outcomeCategories": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 255
      }
    },
    "ltvBand": {
      "enum": [
        "a",
        "b",
        "c",
        null
      ]
    },
    "sensitiveFinancialExcluded": {
      "const": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highvaluecapitalgroup.com/contracts/proposal-context.v1.json",
  "title": "Proposal Context v1",
  "description": "Atlas proposal context linking opportunity, offer, and pricing. Does not auto-send proposals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "proposalId",
    "opportunityId",
    "clientCode",
    "status"
  ],
  "properties": {
    "contractVersion": {
      "const": "proposal-context.v1"
    },
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "opportunityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "clientCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2,15}$"
    },
    "offerSku": {
      "type": "string",
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "internal_review",
        "ready",
        "sent",
        "accepted",
        "declined",
        "expired"
      ]
    },
    "autoSend": {
      "const": false
    },
    "attribution": {
      "$ref": "./attribution-lineage.v1.json"
    }
  }
}

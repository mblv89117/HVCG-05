{
  "version": "1.0.0",
  "asOf": "2026-08-11",
  "authority": "CR-HVCG-BA-V2-001",
  "note": "Configurations on shared Atlas AI orchestration — not separate codebases. External communication defaults to false.",
  "riskLevels": ["LOW", "MEDIUM", "HIGH"],
  "absoluteProhibitions": [
    "Guarantee financing",
    "Guarantee a contract",
    "Guarantee recovery",
    "Provide legal advice or act as attorney",
    "Provide tax opinions or act as CPA",
    "Certify financials",
    "Sell/bind insurance or conclusively determine coverage",
    "Terminate employees or make protected-class employment decisions",
    "Submit government bids or registrations without approval",
    "Commit HVCG pricing",
    "Sign agreements",
    "Transfer money or issue refunds",
    "Approve partner payouts",
    "Send sensitive communications without approval",
    "Contact attorneys/insurers/lenders without required human approval",
    "Expose restricted documents"
  ],
  "agents": [
    { "agentCode": "AGT-INTAKE", "name": "Client Intake Agent", "riskLevel": "LOW", "externalCommunicationAllowed": false, "humanApproval": "conditional" },
    {
      "agentCode": "AGT-DOC-CHECKLIST",
      "name": "Document Checklist Agent",
      "riskLevel": "LOW",
      "externalCommunicationAllowed": false,
      "humanApproval": "conditional",
      "runtime": "config/business/capital_readiness.py#build_document_checklist",
      "triggers": ["Paid Capital Diagnostic", "Capital Request created"],
      "inputs": ["financingType", "amount", "transactionHints"],
      "outputs": ["conditionalDocumentChecklist"]
    },
    {
      "agentCode": "AGT-CAP-READY",
      "name": "Capital Readiness Agent",
      "riskLevel": "MEDIUM",
      "externalCommunicationAllowed": false,
      "humanApproval": "required_for_conclusion_and_external",
      "runtime": "config/business/capital_readiness.py#run_capital_readiness_diagnostic",
      "triggers": ["Paid Capital Diagnostic"],
      "inputs": [
        "Financials",
        "Tax returns",
        "Bank statements",
        "Debt schedule",
        "Capital request",
        "Client/account data",
        "Document tracker",
        "Finance intelligence where authorized"
      ],
      "outputs": [
        "readinessScore",
        "missingDocumentList",
        "lenderConcernList",
        "strengthList",
        "fundingPathDraft",
        "readinessMemoDraft",
        "recommendedNextOffer"
      ],
      "never": [
        "guarantee approval",
        "submit to lender",
        "fabricate data",
        "modify source financials",
        "provide securities advice",
        "certify financial statements"
      ]
    },
    {
      "agentCode": "AGT-FIN-PKG",
      "name": "Financial Package Agent",
      "riskLevel": "MEDIUM",
      "externalCommunicationAllowed": false,
      "humanApproval": "required_for_external",
      "runtime": "config/business/financial_package.py#run_financial_package_agent",
      "handoffFrom": "AGT-CAP-READY",
      "handoffStatus": "READY_FOR_PACKAGE_BUILD",
      "policy": "config/business/capital-package-policy.json",
      "outputs": [
        "packageChecklist",
        "financialSummaryDraft",
        "missingInformationList",
        "conflictList",
        "documentIndex",
        "packageCompletenessScore",
        "lenderMemoDraft",
        "packageQaRecord"
      ],
      "never": [
        "certify financial statements",
        "modify source financial documents",
        "invent financial figures",
        "act as CPA",
        "resolve conflicts silently",
        "label unaudited as audited",
        "label projections as historical fact",
        "send package to lenders without human approval",
        "guarantee lending outcomes",
        "auto submit SBA forms"
      ],
      "note": "Sprint 6 runtime operational in Development. APPROVED_FOR_LENDER_SUBMISSION remains submission-gated (BL-C1)."
    },
    { "agentCode": "AGT-PROCURE", "name": "Contract Procurement Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always_before_external" },
    { "agentCode": "AGT-GOV-REG", "name": "Government Registration Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always_before_submit" },
    { "agentCode": "AGT-TAX-APPEAL", "name": "Regulatory / Tax Appeal Support Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always" },
    { "agentCode": "AGT-UE-CLAIM", "name": "Unemployment Claim Support Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always" },
    { "agentCode": "AGT-INS-REVIEW", "name": "Risk / Insurance Review Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always" },
    { "agentCode": "AGT-CLAIMS", "name": "Claims & Recovery Support Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always" },
    { "agentCode": "AGT-HR-DOCS", "name": "HR / Workforce Documentation Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always" },
    { "agentCode": "AGT-PROPOSAL", "name": "Proposal & Pricing Agent", "riskLevel": "MEDIUM", "externalCommunicationAllowed": false, "humanApproval": "always_before_send" },
    { "agentCode": "AGT-CRM", "name": "CRM Update Agent", "riskLevel": "LOW", "externalCommunicationAllowed": false, "humanApproval": "conditional" },
    { "agentCode": "AGT-INVOICE", "name": "Invoice & Payment Reconciliation Agent", "riskLevel": "MEDIUM", "externalCommunicationAllowed": false, "humanApproval": "required_for_payouts" },
    { "agentCode": "AGT-REFERRAL", "name": "Referral Partner Agent", "riskLevel": "MEDIUM", "externalCommunicationAllowed": false, "humanApproval": "required_for_payouts" },
    { "agentCode": "AGT-SUCCESS", "name": "Client Success Agent", "riskLevel": "LOW", "externalCommunicationAllowed": false, "humanApproval": "conditional" },
    { "agentCode": "AGT-CONCIERGE", "name": "Executive Concierge Agent", "riskLevel": "HIGH", "externalCommunicationAllowed": false, "humanApproval": "always", "restricted": true },
    { "agentCode": "AGT-SECOND-BRAIN", "name": "AI Second Brain Agent", "riskLevel": "MEDIUM", "externalCommunicationAllowed": false, "humanApproval": "permission_aware_retrieval" }
  ]
}

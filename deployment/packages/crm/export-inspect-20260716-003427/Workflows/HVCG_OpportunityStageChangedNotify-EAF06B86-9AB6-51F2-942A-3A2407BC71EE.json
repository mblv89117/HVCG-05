{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "10.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "hvcg_CommandCenterSiteUrl": {
          "type": "String",
          "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-CommandCenter-Dev"
        },
        "hvcg_CrmEnableTeamsNotify": {
          "type": "Bool",
          "defaultValue": false
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 1
          }
        }
      },
      "actions": {
        "Http_List": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/lists/getbytitle('HVCG_Opportunities')/items?$select=Id,Title,Stage,SalesOwnerEmail,OwnerEmail&$orderby=Id desc&$top=10",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            }
          }
        },
        "Apply": {
          "type": "Foreach",
          "foreach": "@body('Http_List')?['value']",
          "runAfter": {
            "Http_List": [
              "Succeeded"
            ]
          },
          "actions": {
            "ComposeStage": {
              "type": "Compose",
              "inputs": "@coalesce(items('Apply')?['Stage'], '')"
            },
            "HttpFind": {
              "type": "OpenApiConnection",
              "runAfter": {
                "ComposeStage": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_OpportunityActivities')/items?$filter=HVCG_IdempotencyKey eq 'opp-stage|@{items('Apply')?['Id']}|@{outputs('ComposeStage')}'&$select=Id&$top=1",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                }
              }
            },
            "Need": {
              "type": "If",
              "runAfter": {
                "HttpFind": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "expression": {
                "equals": [
                  "@empty(coalesce(body('HttpFind')?['value'], createArray()))",
                  true
                ]
              },
              "actions": {
                "LogS": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                      "table": "HVCG_AutomationLogs",
                      "item/Title": "Started",
                      "item/FlowName": "HVCG_OpportunityStageChangedNotify",
                      "item/Status": {
                        "Value": "Started"
                      },
                      "item/Message": "Opp @{items('Apply')?['Id']} @{outputs('ComposeStage')}"
                    }
                  }
                },
                "Create": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "LogS": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                      "table": "HVCG_OpportunityActivities",
                      "item/Title": "Stage @{outputs('ComposeStage')}",
                      "item/ActivityType": {
                        "Value": "StageChange"
                      },
                      "item/NewStage": "@outputs('ComposeStage')",
                      "item/OwnerEmail": "@coalesce(items('Apply')?['SalesOwnerEmail'], items('Apply')?['OwnerEmail'], 'manny@highvaluecapitalgroup.com')",
                      "item/ActivityDate": "@utcNow()",
                      "item/OpportunityId": {
                        "Id": "@items('Apply')?['Id']"
                      },
                      "item/HVCG_IdempotencyKey": "opp-stage|@{items('Apply')?['Id']}|@{outputs('ComposeStage')}"
                    }
                  }
                },
                "LogOk": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Create": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                      "table": "HVCG_AutomationLogs",
                      "item/Title": "Succeeded",
                      "item/FlowName": "HVCG_OpportunityStageChangedNotify",
                      "item/Status": {
                        "Value": "Succeeded"
                      },
                      "item/RelatedList": "HVCG_Opportunities",
                      "item/RelatedItemId": "@items('Apply')?['Id']",
                      "item/Message": "@concat('Stage activity for opp ', string(items('Apply')?['Id']))"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Skip": {
                    "type": "Compose",
                    "inputs": "skip"
                  }
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
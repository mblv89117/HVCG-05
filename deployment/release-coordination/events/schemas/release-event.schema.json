{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasReleaseOrchestratorEvent",
  "type": "object",
  "required": ["eventId", "eventType", "emittedAt", "source"],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": {
      "enum": [
        "RC_ASSIGNED",
        "QA_STATUS_CHANGED",
        "MERGE_CANDIDATE_READY",
        "BLOCKING_ISSUE_RESOLVED",
        "DEPLOYMENT_APPROVAL_GRANTED",
        "ROLLBACK_REQUESTED",
        "PRODUCTION_INCIDENT",
        "SYNC_REQUESTED"
      ]
    },
    "emittedAt": { "type": "string" },
    "source": {
      "type": "string",
      "description": "master-pm | qa-release | orchestration | owner | monitoring | incident"
    },
    "releaseVersion": { "type": ["string", "null"] },
    "taskId": { "type": ["string", "null"] },
    "commitSha": { "type": ["string", "null"] },
    "qaStatus": { "type": ["string", "null"], "enum": ["PENDING", "GO", "NO-GO", null] },
    "masterPmApproval": { "type": ["boolean", "null"] },
    "ownerApproval": { "type": ["boolean", "null"] },
    "deploymentApprovalGranted": { "type": ["boolean", "null"] },
    "blockingIssueId": { "type": ["string", "null"] },
    "incidentSeverity": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "notes": { "type": "string" }
  }
}

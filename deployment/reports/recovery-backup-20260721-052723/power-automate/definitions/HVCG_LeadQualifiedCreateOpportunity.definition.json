{
  "name": "HVCG_LeadQualifiedCreateOpportunity",
  "displayName": "HVCG_LeadQualifiedCreateOpportunity",
  "description": "Create Discovery opportunity when LeadStatus becomes Qualified (CRM package 1.1.0)",
  "defaultState": "Off",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": { "defaultValue": {}, "type": "SecureObject" },
      "$connections": { "defaultValue": {}, "type": "Object" },
      "hvcg_CommandCenterSiteUrl": { "type": "String" },
      "hvcg_TeamsCrmChannelId": { "type": "String", "defaultValue": "" },
      "hvcg_TeamsCrmChannelGroupId": { "type": "String", "defaultValue": "" },
      "hvcg_CrmTestRecipient": { "type": "String", "defaultValue": "" },
      "hvcg_CrmEnableTeamsNotify": { "type": "Bool", "defaultValue": false }
    },
    "triggers": {
      "When_lead_modified": {
        "type": "OpenApiConnectionWebhook",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetOnUpdatedItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_Leads"
          },
          "splitOn": "@triggerOutputs()?['body/value']"
        }
      }
    },
    "actions": {
      "Log_Start": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Started",
            "item/FlowName": "HVCG_LeadQualifiedCreateOpportunity",
            "item/Status": "Started"
          }
        },
        "runAfter": {}
      },
      "Condition_Qualified": {
        "type": "If",
        "expression": {
          "and": [{ "equals": ["@triggerOutputs()?['body/LeadStatus']", "Qualified"] }]
        },
        "actions": {
          "Compose_OpportunityType": {
            "type": "Compose",
            "inputs": "Map ServiceInterest → OpportunityType per flows/HVCG_LeadQualifiedCreateOpportunity.json fieldMap; default Other"
          },
          "Find_Existing_By_Idempotency": {
            "type": "Compose",
            "inputs": "GetItems HVCG_Opportunities where HVCG_IdempotencyKey eq opp-from-lead|{LeadId}; if found SkippedDuplicate",
            "runAfter": { "Compose_OpportunityType": ["Succeeded"] }
          },
          "Create_Or_Reuse_Opportunity": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PostItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_Opportunities",
                "item/Title": "@{triggerOutputs()?['body/Title']} — Discovery",
                "item/Stage": "Discovery",
                "item/WinLossStatus": "Open",
                "item/ForecastCategory": "Pipeline",
                "item/CapitalHandoffStatus": "NotApplicable",
                "item/Probability": 20,
                "item/ProposalAmount": "@triggerOutputs()?['body/EstimatedValue']",
                "item/OwnerEmail": "@triggerOutputs()?['body/OwnerEmail']",
                "item/SalesOwnerEmail": "@triggerOutputs()?['body/OwnerEmail']",
                "item/HVCG_IdempotencyKey": "opp-from-lead|@{triggerOutputs()?['body/ID']}",
                "item/CopilotSummary": "Created from qualified lead @{triggerOutputs()?['body/Title']}"
              }
            },
            "runAfter": { "Find_Existing_By_Idempotency": ["Succeeded"] }
          },
          "Update_Lead_ConvertedOpportunityId": {
            "type": "Compose",
            "inputs": "Patch HVCG_Leads ConvertedOpportunityId lookup to created/reused Opportunity Id",
            "runAfter": { "Create_Or_Reuse_Opportunity": ["Succeeded"] }
          },
          "Create_Activity": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PostItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_OpportunityActivities",
                "item/Title": "Lead qualified → opportunity created",
                "item/ActivityType": "StageChange",
                "item/NewStage": "Discovery",
                "item/ActivityDate": "@utcNow()",
                "item/HVCG_IdempotencyKey": "act-lead-qualify|@{triggerOutputs()?['body/ID']}"
              }
            },
            "runAfter": { "Update_Lead_ConvertedOpportunityId": ["Succeeded"] }
          },
          "Condition_Teams_Notify": {
            "type": "If",
            "expression": {
              "and": [{ "equals": ["@parameters('hvcg_CrmEnableTeamsNotify')", true] }]
            },
            "actions": {
              "Post_Teams_Test_Only": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_teams",
                    "operationId": "PostMessageToChannel",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Channel",
                    "body/recipient/groupId": "@parameters('hvcg_TeamsCrmChannelGroupId')",
                    "body/recipient/channelId": "@parameters('hvcg_TeamsCrmChannelId')",
                    "body/messageBody": "Qualified lead opened a CRM opportunity (test channel only)."
                  }
                }
              }
            },
            "runAfter": { "Create_Activity": ["Succeeded"] }
          },
          "Log_Success": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PostItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_AutomationLogs",
                "item/Title": "Succeeded",
                "item/FlowName": "HVCG_LeadQualifiedCreateOpportunity",
                "item/Status": "Succeeded"
              }
            },
            "runAfter": { "Condition_Teams_Notify": ["Succeeded", "Skipped", "TimedOut"] }
          }
        },
        "runAfter": { "Log_Start": ["Succeeded"] }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": { "connectionReferenceLogicalName": "hvcg_sharedsharepointonline" },
      "api": { "name": "shared_sharepointonline" }
    },
    "shared_teams": {
      "runtimeSource": "embedded",
      "connection": { "connectionReferenceLogicalName": "hvcg_sharedteams" },
      "api": { "name": "shared_teams" }
    },
    "shared_office365": {
      "runtimeSource": "embedded",
      "connection": { "connectionReferenceLogicalName": "hvcg_sharedoffice365" },
      "api": { "name": "shared_office365" }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_TeamsCrmChannelId",
    "hvcg_TeamsCrmChannelGroupId",
    "hvcg_OpsEmail",
    "hvcg_CrmTestRecipient",
    "hvcg_CrmEnableTeamsNotify"
  ],
  "outboundPolicy": {
    "teamsEnabledByDefault": false,
    "emailEnabledByDefault": false,
    "recipientMode": "testOnly"
  },
  "buildSheet": "src/power-automate/flows/HVCG_LeadQualifiedCreateOpportunity.json",
  "acceptanceCriteria": [
    "Imported Off; connection refs resolve to HVCG SharePoint/Teams/Outlook",
    "Test run writes AutomationLogs Started/Succeeded or SkippedDuplicate",
    "Idempotent re-run does not duplicate Opportunities",
    "Teams action skipped unless hvcg_CrmEnableTeamsNotify=true"
  ]
}

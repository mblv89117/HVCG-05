{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hvcg_sharedoffice365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "10.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "hvcg_CommandCenterSiteUrl": {
          "type": "String",
          "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-CommandCenter"
        },
        "hvcg_ClientsSiteUrl": {
          "type": "String",
          "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-Clients"
        },
        "hvcg_EnableClientEmails": {
          "type": "Bool",
          "defaultValue": false
        },
        "hvcg_OpsEmail": {
          "type": "String",
          "defaultValue": "manuel@highvaluecapitalgroup.com"
        },
        "hvcg_ExecutiveEmail": {
          "type": "String",
          "defaultValue": "manuel@highvaluecapitalgroup.com"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "ClientCode": {
                  "type": "string",
                  "title": "ClientCode",
                  "description": "Short unique client code, e.g. ACME01"
                },
                "ClientListItemId": {
                  "type": "integer",
                  "title": "ClientListItemId",
                  "description": "Optional HVCG_Clients item Id (skips ClientCode lookup)"
                },
                "TemplateKey": {
                  "type": "string",
                  "title": "TemplateKey",
                  "description": "Project template key (default general-client-onboarding)"
                },
                "StartDate": {
                  "type": "string",
                  "title": "StartDate",
                  "description": "Optional ISO date the project starts (defaults to today)"
                }
              },
              "required": [
                "ClientCode"
              ]
            }
          }
        }
      },
      "actions": {
        "Log_Start": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
              "table": "HVCG_AutomationLogs",
              "item": {
                "Title": "Started",
                "FlowName": "@workflow()?['name']",
                "Status": {
                  "Value": "Started"
                },
                "ClientCode": "@triggerBody()?['ClientCode']"
              }
            }
          },
          "runAfter": {}
        },
        "Init_ClientId": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ClientId",
                "type": "integer",
                "value": "@coalesce(triggerBody()?['ClientListItemId'], 0)"
              }
            ]
          },
          "runAfter": {
            "Log_Start": [
              "Succeeded"
            ]
          }
        },
        "Init_TemplateKey": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "TemplateKey",
                "type": "string",
                "value": "@coalesce(triggerBody()?['TemplateKey'], 'general-client-onboarding')"
              }
            ]
          },
          "runAfter": {
            "Init_ClientId": [
              "Succeeded"
            ]
          }
        },
        "Init_StartDate": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "StartDate",
                "type": "string",
                "value": "@coalesce(triggerBody()?['StartDate'], utcNow())"
              }
            ]
          },
          "runAfter": {
            "Init_TemplateKey": [
              "Succeeded"
            ]
          }
        },
        "Compose_IdempotencyKey": {
          "type": "Compose",
          "inputs": "@concat('proj|', triggerBody()?['ClientCode'], '|', variables('TemplateKey'), '|', formatDateTime(utcNow(), 'yyyyMMdd'))",
          "runAfter": {
            "Init_StartDate": [
              "Succeeded"
            ]
          }
        },
        "Condition_NeedClientLookup": {
          "type": "If",
          "expression": {
            "and": [
              {
                "lessOrEquals": [
                  "@variables('ClientId')",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Get_Client_ByCode": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Clients",
                  "$filter": "ClientCode eq '@{triggerBody()?['ClientCode']}'",
                  "$top": 1
                }
              },
              "runAfter": {}
            },
            "Set_ClientId": {
              "type": "SetVariable",
              "inputs": {
                "name": "ClientId",
                "value": "@int(first(outputs('Get_Client_ByCode')?['body/value'])?['ID'])"
              },
              "runAfter": {
                "Get_Client_ByCode": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Compose_IdempotencyKey": [
              "Succeeded"
            ]
          }
        },
        "Get_Existing_Project": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
              "table": "HVCG_Projects",
              "$filter": "HVCG_IdempotencyKey eq '@{outputs('Compose_IdempotencyKey')}'",
              "$top": 1
            }
          },
          "runAfter": {
            "Condition_NeedClientLookup": [
              "Succeeded"
            ]
          }
        },
        "Condition_Duplicate": {
          "type": "If",
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(outputs('Get_Existing_Project')?['body/value'])",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Log_Skipped": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_AutomationLogs",
                  "item": {
                    "Title": "Project SkippedDuplicate",
                    "FlowName": "@workflow()?['name']",
                    "Status": {
                      "Value": "SkippedDuplicate"
                    },
                    "ClientCode": "@triggerBody()?['ClientCode']",
                    "IdempotencyKey": "@outputs('Compose_IdempotencyKey')",
                    "RelatedList": "HVCG_Projects",
                    "RelatedItemId": "@int(first(outputs('Get_Existing_Project')?['body/value'])?['ID'])"
                  }
                }
              },
              "runAfter": {}
            },
            "Terminate_Skipped": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {
                "Log_Skipped": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Create_Project": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Projects",
                    "item": {
                      "Title": "@concat(triggerBody()?['ClientCode'], ' - ', variables('TemplateKey'))",
                      "ClientIdId": "@variables('ClientId')",
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "ProjectTemplateKey": "@variables('TemplateKey')",
                      "ProjectStatus": {
                        "Value": "Not Started"
                      },
                      "ProjectHealth": {
                        "Value": "Green"
                      },
                      "ProjectOwnerEmail": "@parameters('hvcg_OpsEmail')",
                      "StartDate": "@variables('StartDate')",
                      "TargetEndDate": "@addDays(variables('StartDate'), 21)",
                      "HVCG_IdempotencyKey": "@outputs('Compose_IdempotencyKey')"
                    }
                  }
                },
                "runAfter": {}
              },
              "Create_Milestone_Kickoff": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Milestones",
                    "item": {
                      "Title": "Kickoff completed",
                      "ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "DueDate": "@addDays(variables('StartDate'), 2)",
                      "Status": {
                        "Value": "Pending"
                      },
                      "IsCritical": true
                    }
                  }
                },
                "runAfter": {
                  "Create_Project": [
                    "Succeeded"
                  ]
                }
              },
              "Create_Milestone_CriticalDocs": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Milestones",
                    "item": {
                      "Title": "Critical documents received",
                      "ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "DueDate": "@addDays(variables('StartDate'), 14)",
                      "Status": {
                        "Value": "Pending"
                      },
                      "IsCritical": true
                    }
                  }
                },
                "runAfter": {
                  "Create_Milestone_Kickoff": [
                    "Succeeded"
                  ]
                }
              },
              "Create_Milestone_OnboardingComplete": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Milestones",
                    "item": {
                      "Title": "Onboarding complete",
                      "ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "DueDate": "@addDays(variables('StartDate'), 21)",
                      "Status": {
                        "Value": "Pending"
                      },
                      "IsCritical": false
                    }
                  }
                },
                "runAfter": {
                  "Create_Milestone_CriticalDocs": [
                    "Succeeded"
                  ]
                }
              },
              "Create_Task_Kickoff": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Tasks",
                    "item": {
                      "Title": "Schedule and run kickoff call",
                      "ClientIdId": "@variables('ClientId')",
                      "ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "TaskStatus": {
                        "Value": "Not Started"
                      },
                      "Priority": {
                        "Value": "High"
                      },
                      "OwnerEmail": "@parameters('hvcg_OpsEmail')",
                      "DueDate": "@addDays(variables('StartDate'), 2)",
                      "DependsOnTaskKeys": "",
                      "TemplateTaskKey": "kickoff",
                      "HVCG_IdempotencyKey": "@concat(outputs('Compose_IdempotencyKey'), '|kickoff')"
                    }
                  }
                },
                "runAfter": {
                  "Create_Milestone_OnboardingComplete": [
                    "Succeeded"
                  ]
                }
              },
              "Create_Task_CollectDocs": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Tasks",
                    "item": {
                      "Title": "Collect critical onboarding documents",
                      "ClientIdId": "@variables('ClientId')",
                      "ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "TaskStatus": {
                        "Value": "Not Started"
                      },
                      "Priority": {
                        "Value": "High"
                      },
                      "OwnerEmail": "@parameters('hvcg_OpsEmail')",
                      "DueDate": "@addDays(variables('StartDate'), 7)",
                      "DependsOnTaskKeys": "kickoff",
                      "TemplateTaskKey": "collect-critical-docs",
                      "HVCG_IdempotencyKey": "@concat(outputs('Compose_IdempotencyKey'), '|collect-critical-docs')"
                    }
                  }
                },
                "runAfter": {
                  "Create_Task_Kickoff": [
                    "Succeeded"
                  ]
                }
              },
              "Create_Task_OnboardingReview": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Tasks",
                    "item": {
                      "Title": "Complete onboarding review",
                      "ClientIdId": "@variables('ClientId')",
                      "ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "TaskStatus": {
                        "Value": "Not Started"
                      },
                      "Priority": {
                        "Value": "Medium"
                      },
                      "OwnerEmail": "@parameters('hvcg_OpsEmail')",
                      "DueDate": "@addDays(variables('StartDate'), 21)",
                      "DependsOnTaskKeys": "collect-critical-docs",
                      "TemplateTaskKey": "onboarding-review",
                      "HVCG_IdempotencyKey": "@concat(outputs('Compose_IdempotencyKey'), '|onboarding-review')"
                    }
                  }
                },
                "runAfter": {
                  "Create_Task_CollectDocs": [
                    "Succeeded"
                  ]
                }
              },
              "Log_Success": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_AutomationLogs",
                    "item": {
                      "Title": "Project created",
                      "FlowName": "@workflow()?['name']",
                      "Status": {
                        "Value": "Succeeded"
                      },
                      "ClientCode": "@triggerBody()?['ClientCode']",
                      "IdempotencyKey": "@outputs('Compose_IdempotencyKey')",
                      "RelatedList": "HVCG_Projects",
                      "RelatedItemId": "@outputs('Create_Project')?['body/ID']",
                      "Message": "@concat('Created project id ', string(outputs('Create_Project')?['body/ID']), ' with 3 milestones and 3 tasks')"
                    }
                  }
                },
                "runAfter": {
                  "Create_Task_OnboardingReview": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "Get_Existing_Project": [
              "Succeeded"
            ]
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
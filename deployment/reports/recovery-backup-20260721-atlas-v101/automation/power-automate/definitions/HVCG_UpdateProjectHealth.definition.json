{
  "name": "HVCG_UpdateProjectHealth",
  "displayName": "HVCG_UpdateProjectHealth",
  "description": "Daily project health recalculation",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 1,
          "startTime": "2026-01-01T06:00:00",
          "timeZone": "Pacific Standard Time"
        }
      }
    },
    "actions": {
      "Log_Start": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Started",
            "item/FlowName": "@workflow()?['name']",
            "item/Status": "Started"
          }
        },
        "runAfter": {}
      },
      "Compose_Work": {
        "type": "Compose",
        "inputs": "Implement steps from src/power-automate/flows/HVCG_UpdateProjectHealth.json against HVCG lists using GetItems + conditions. Idempotent via HVCG_IdempotencyKey.",
        "runAfter": {
          "Log_Start": [
            "Succeeded"
          ]
        }
      },
      "Log_Success": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "HVCG_UpdateProjectHealth completed scaffold",
            "item/FlowName": "HVCG_UpdateProjectHealth",
            "item/Status": "Succeeded"
          }
        },
        "runAfter": {
          "Compose_Work": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
      },
      "api": {
        "name": "shared_sharepointonline"
      }
    },
    "shared_office365": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedoffice365"
      },
      "api": {
        "name": "shared_office365"
      }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_ClientsSiteUrl",
    "hvcg_ExecutiveEmail",
    "hvcg_OpsEmail",
    "hvcg_EnableClientEmails"
  ],
  "acceptanceCriteria": [
    "Flow appears in solution or My flows",
    "Connection references resolved",
    "Test run writes HVCG_AutomationLogs Started/Succeeded or SkippedDuplicate",
    "Idempotent re-run does not duplicate business records"
  ]
}
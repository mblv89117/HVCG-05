{
  "flowName": "HVCG_CreateClientWorkspace",
  "displayName": "HVCG_CreateClientWorkspace",
  "description": "Creates client library, folders 00-23, permissions, updates client URL.",
  "trigger": {
    "type": "ManualOrChild",
    "inputs": [
      "ClientCode",
      "ClientDisplayName",
      "ClientListItemId"
    ]
  },
  "connections": [
    "SharePoint"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [],
  "steps": [
    {
      "id": 1,
      "action": "EnsureSecurityGroup",
      "params": {
        "name": "HVCG-Client-{ClientCode}"
      }
    },
    {
      "id": 2,
      "action": "CreateDocumentLibrary",
      "params": {
        "site": "HVCG_CLIENTS_HUB_URL",
        "title": "HVCG_{ClientCode}"
      }
    },
    {
      "id": 3,
      "action": "CreateFolders",
      "params": {
        "fromConfig": "documentFolderStructure"
      }
    },
    {
      "id": 4,
      "action": "BreakInheritanceAndGrant"
    },
    {
      "id": 5,
      "action": "UpdateClientSharePointLibraryUrl"
    },
    {
      "id": 6,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60
  },
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_CLIENTS_HUB_URL",
    "HVCG_OPS_EMAIL",
    "HVCG_EXECUTIVE_EMAIL",
    "HVCG_ENABLE_CLIENT_EMAILS"
  ]
}
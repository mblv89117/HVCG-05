{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hvcg_sharedoffice365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "10.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "hvcg_CommandCenterSiteUrl": {
          "type": "String",
          "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-CommandCenter"
        },
        "hvcg_ClientsSiteUrl": {
          "type": "String",
          "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-Clients"
        },
        "hvcg_EnableClientEmails": {
          "type": "Bool",
          "defaultValue": false
        },
        "hvcg_OpsEmail": {
          "type": "String",
          "defaultValue": "manuel@highvaluecapitalgroup.com"
        },
        "hvcg_ExecutiveEmail": {
          "type": "String",
          "defaultValue": "manuel@highvaluecapitalgroup.com"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "ClientCode": {
                  "type": "string",
                  "title": "ClientCode",
                  "description": "Short unique client code, e.g. ACME01"
                },
                "ClientListItemId": {
                  "type": "integer",
                  "title": "ClientListItemId",
                  "description": "Optional HVCG_Clients item Id (skips ClientCode lookup)"
                },
                "ProjectId": {
                  "type": "integer",
                  "title": "ProjectId",
                  "description": "Optional HVCG_Projects item Id to link the requests to"
                },
                "DocumentTitles": {
                  "type": "array",
                  "title": "DocumentTitles",
                  "description": "Optional list of document titles; if empty a standard set of 3 is created",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "ClientCode"
              ]
            }
          }
        }
      },
      "actions": {
        "Log_Start": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
              "table": "HVCG_AutomationLogs",
              "item": {
                "Title": "Started",
                "FlowName": "@workflow()?['name']",
                "Status": {
                  "Value": "Started"
                },
                "ClientCode": "@triggerBody()?['ClientCode']"
              }
            }
          },
          "runAfter": {}
        },
        "Init_ClientId": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "ClientId",
                "type": "integer",
                "value": "@coalesce(triggerBody()?['ClientListItemId'], 0)"
              }
            ]
          },
          "runAfter": {
            "Log_Start": [
              "Succeeded"
            ]
          }
        },
        "Init_Created": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "CreatedCount",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Init_ClientId": [
              "Succeeded"
            ]
          }
        },
        "Init_Skipped": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "SkippedCount",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Init_Created": [
              "Succeeded"
            ]
          }
        },
        "Init_DocsToCreate": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "DocsToCreate",
                "type": "array",
                "value": [
                  {
                    "Title": "Corporate formation and governance documents",
                    "Category": "Corporate",
                    "FolderTarget": "01 - Corporate Documents"
                  },
                  {
                    "Title": "Trailing twelve months financial statements",
                    "Category": "Current Financials",
                    "FolderTarget": "04 - Current Financials"
                  },
                  {
                    "Title": "Most recent business tax return",
                    "Category": "Tax Returns",
                    "FolderTarget": "05 - Tax Returns"
                  }
                ]
              }
            ]
          },
          "runAfter": {
            "Init_Skipped": [
              "Succeeded"
            ]
          }
        },
        "Condition_NeedClientLookup": {
          "type": "If",
          "expression": {
            "and": [
              {
                "lessOrEquals": [
                  "@variables('ClientId')",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Get_Client_ByCode": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Clients",
                  "$filter": "ClientCode eq '@{triggerBody()?['ClientCode']}'",
                  "$top": 1
                }
              },
              "runAfter": {}
            },
            "Set_ClientId": {
              "type": "SetVariable",
              "inputs": {
                "name": "ClientId",
                "value": "@int(first(outputs('Get_Client_ByCode')?['body/value'])?['ID'])"
              },
              "runAfter": {
                "Get_Client_ByCode": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Init_DocsToCreate": [
              "Succeeded"
            ]
          }
        },
        "Condition_HasTitles": {
          "type": "If",
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(coalesce(triggerBody()?['DocumentTitles'], json('[]')))",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Select_Titles": {
              "type": "Select",
              "inputs": {
                "from": "@triggerBody()?['DocumentTitles']",
                "select": {
                  "Title": "@item()",
                  "Category": "Other",
                  "FolderTarget": "00 - Engagement Administration"
                }
              },
              "runAfter": {}
            },
            "Set_DocsToCreate": {
              "type": "SetVariable",
              "inputs": {
                "name": "DocsToCreate",
                "value": "@body('Select_Titles')"
              },
              "runAfter": {
                "Select_Titles": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Condition_NeedClientLookup": [
              "Succeeded"
            ]
          }
        },
        "Apply_to_each_Doc": {
          "type": "Foreach",
          "foreach": "@variables('DocsToCreate')",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Get_Open_Duplicates": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_DocumentRequests",
                  "$filter": "ClientCode eq '@{triggerBody()?['ClientCode']}' and Title eq '@{item()?['Title']}' and RequestStatus ne 'Received' and RequestStatus ne 'Waived' and RequestStatus ne 'Cancelled'",
                  "$top": 1
                }
              },
              "runAfter": {}
            },
            "Condition_OpenExists": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(outputs('Get_Open_Duplicates')?['body/value'])",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Increment_Skipped": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "SkippedCount",
                    "value": 1
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Create_Document_Request": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PostItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                        "table": "HVCG_DocumentRequests",
                        "item": {
                          "Title": "@item()?['Title']",
                          "ClientIdId": "@variables('ClientId')",
                          "ProjectIdId": "@if(greater(coalesce(triggerBody()?['ProjectId'], 0), 0), triggerBody()?['ProjectId'], null)",
                          "ClientCode": "@triggerBody()?['ClientCode']",
                          "DocumentCategory": {
                            "Value": "@item()?['Category']"
                          },
                          "RequestDate": "@utcNow()",
                          "DueDate": "@addDays(utcNow(), 7)",
                          "RequestStatus": {
                            "Value": "Requested"
                          },
                          "InternalOwnerEmail": "@parameters('hvcg_OpsEmail')",
                          "FolderTarget": "@item()?['FolderTarget']",
                          "Audience": {
                            "Value": "Client"
                          },
                          "HVCG_IdempotencyKey": "@concat('docreq|', triggerBody()?['ClientCode'], '|', item()?['Title'])"
                        }
                      }
                    },
                    "runAfter": {}
                  },
                  "Increment_Created": {
                    "type": "IncrementVariable",
                    "inputs": {
                      "name": "CreatedCount",
                      "value": 1
                    },
                    "runAfter": {
                      "Create_Document_Request": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Get_Open_Duplicates": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Condition_HasTitles": [
              "Succeeded"
            ]
          }
        },
        "Log_Success": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
              "table": "HVCG_AutomationLogs",
              "item": {
                "Title": "Document requests created",
                "FlowName": "@workflow()?['name']",
                "Status": {
                  "Value": "Succeeded"
                },
                "ClientCode": "@triggerBody()?['ClientCode']",
                "RelatedList": "HVCG_DocumentRequests",
                "Message": "@concat('Created ', string(variables('CreatedCount')), ', skipped ', string(variables('SkippedCount')), ' (open duplicate)')"
              }
            }
          },
          "runAfter": {
            "Apply_to_each_Doc": [
              "Succeeded"
            ]
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
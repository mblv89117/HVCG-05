{
  "name": "atlas-elite-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hvcg/atlas-elite-os",
    "build": "npm run build -w @hvcg/atlas-elite-os",
    "dev:plaid-api": "npm run start -w @hvcg/atlas-plaid-api",
    "test:plaid-api": "npm run test -w @hvcg/atlas-plaid-api",
    "dev:integration-api": "npm run start -w @hvcg/atlas-integration-api",
    "test:integration-api": "npm run test -w @hvcg/atlas-integration-api",
    "test:recovery": "npm run test:recovery -w @hvcg/atlas-elite-os",
    "qa:website-studio": "npm run qa:gate --prefix scripts/website-studio-qa",
    "storybook": "npm run storybook -w @hvcg/atlas-design-system",
    "build-storybook": "npm run build-storybook -w @hvcg/atlas-design-system"
  }
}

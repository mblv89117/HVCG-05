{
  "name": "HVCG_CreateProjectFromTemplate",
  "displayName": "HVCG_CreateProjectFromTemplate",
  "description": "Create a delivery project with kickoff milestones and onboarding tasks for a client, linked by ClientId lookup. Idempotent per client/template/day.",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Button",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "ClientCode": {
                "type": "string",
                "title": "ClientCode",
                "description": "Short unique client code, e.g. ACME01"
              },
              "ClientListItemId": {
                "type": "integer",
                "title": "ClientListItemId",
                "description": "Optional HVCG_Clients item Id (skips ClientCode lookup)"
              },
              "TemplateKey": {
                "type": "string",
                "title": "TemplateKey",
                "description": "Project template key (default general-client-onboarding)"
              },
              "StartDate": {
                "type": "string",
                "title": "StartDate",
                "description": "Optional ISO date the project starts (defaults to today)"
              }
            },
            "required": [
              "ClientCode"
            ]
          }
        }
      }
    },
    "actions": {
      "Log_Start": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Started",
            "item/FlowName": "@workflow()?['name']",
            "item/Status": {
              "Value": "Started"
            },
            "item/ClientCode": "@triggerBody()?['ClientCode']"
          }
        },
        "runAfter": {}
      },
      "Init_ClientId": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "ClientId",
              "type": "integer",
              "value": "@coalesce(triggerBody()?['ClientListItemId'], 0)"
            }
          ]
        },
        "runAfter": {
          "Log_Start": [
            "Succeeded"
          ]
        }
      },
      "Init_TemplateKey": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "TemplateKey",
              "type": "string",
              "value": "@coalesce(triggerBody()?['TemplateKey'], 'general-client-onboarding')"
            }
          ]
        },
        "runAfter": {
          "Init_ClientId": [
            "Succeeded"
          ]
        }
      },
      "Init_StartDate": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "StartDate",
              "type": "string",
              "value": "@coalesce(triggerBody()?['StartDate'], utcNow())"
            }
          ]
        },
        "runAfter": {
          "Init_TemplateKey": [
            "Succeeded"
          ]
        }
      },
      "Compose_IdempotencyKey": {
        "type": "Compose",
        "inputs": "@concat('proj|', triggerBody()?['ClientCode'], '|', variables('TemplateKey'), '|', formatDateTime(utcNow(), 'yyyyMMdd'))",
        "runAfter": {
          "Init_StartDate": [
            "Succeeded"
          ]
        }
      },
      "Condition_NeedClientLookup": {
        "type": "If",
        "expression": {
          "and": [
            {
              "lessOrEquals": [
                "@variables('ClientId')",
                0
              ]
            }
          ]
        },
        "actions": {
          "Get_Client_ByCode": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_Clients",
                "$filter": "ClientCode eq '@{triggerBody()?['ClientCode']}'",
                "$top": 1
              }
            },
            "runAfter": {}
          },
          "Set_ClientId": {
            "type": "SetVariable",
            "inputs": {
              "name": "ClientId",
              "value": "@int(first(outputs('Get_Client_ByCode')?['body/value'])?['ID'])"
            },
            "runAfter": {
              "Get_Client_ByCode": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Compose_IdempotencyKey": [
            "Succeeded"
          ]
        }
      },
      "Get_Existing_Project": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_Projects",
            "$filter": "HVCG_IdempotencyKey eq '@{outputs('Compose_IdempotencyKey')}'",
            "$top": 1
          }
        },
        "runAfter": {
          "Condition_NeedClientLookup": [
            "Succeeded"
          ]
        }
      },
      "Condition_Duplicate": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greater": [
                "@length(outputs('Get_Existing_Project')?['body/value'])",
                0
              ]
            }
          ]
        },
        "actions": {
          "Log_Skipped": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PostItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_AutomationLogs",
                "item/Title": "Project SkippedDuplicate",
                "item/FlowName": "@workflow()?['name']",
                "item/Status": {
                  "Value": "SkippedDuplicate"
                },
                "item/ClientCode": "@triggerBody()?['ClientCode']",
                "item/IdempotencyKey": "@outputs('Compose_IdempotencyKey')",
                "item/RelatedList": "HVCG_Projects",
                "item/RelatedItemId": "@int(first(outputs('Get_Existing_Project')?['body/value'])?['ID'])"
              }
            },
            "runAfter": {}
          },
          "Terminate_Skipped": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Succeeded"
            },
            "runAfter": {
              "Log_Skipped": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Create_Project": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Projects",
                  "item/Title": "@concat(triggerBody()?['ClientCode'], ' - ', variables('TemplateKey'))",
                  "item/AtlasClientRefId": "@variables('ClientId')",
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/ProjectTemplateKey": "@variables('TemplateKey')",
                  "item/ProjectStatus": {
                    "Value": "Not Started"
                  },
                  "item/ProjectHealth": {
                    "Value": "Green"
                  },
                  "item/ProjectOwnerEmail": "@parameters('hvcg_OpsEmail')",
                  "item/StartDate": "@variables('StartDate')",
                  "item/TargetEndDate": "@addDays(variables('StartDate'), 21)",
                  "item/HVCG_IdempotencyKey": "@outputs('Compose_IdempotencyKey')"
                }
              },
              "runAfter": {}
            },
            "Create_Milestone_Kickoff": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Milestones",
                  "item/Title": "Kickoff completed",
                  "item/ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/DueDate": "@addDays(variables('StartDate'), 2)",
                  "item/Status": {
                    "Value": "Pending"
                  },
                  "item/IsCritical": true
                }
              },
              "runAfter": {
                "Create_Project": [
                  "Succeeded"
                ]
              }
            },
            "Create_Milestone_CriticalDocs": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Milestones",
                  "item/Title": "Critical documents received",
                  "item/ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/DueDate": "@addDays(variables('StartDate'), 14)",
                  "item/Status": {
                    "Value": "Pending"
                  },
                  "item/IsCritical": true
                }
              },
              "runAfter": {
                "Create_Milestone_Kickoff": [
                  "Succeeded"
                ]
              }
            },
            "Create_Milestone_OnboardingComplete": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Milestones",
                  "item/Title": "Onboarding complete",
                  "item/ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/DueDate": "@addDays(variables('StartDate'), 21)",
                  "item/Status": {
                    "Value": "Pending"
                  },
                  "item/IsCritical": false
                }
              },
              "runAfter": {
                "Create_Milestone_CriticalDocs": [
                  "Succeeded"
                ]
              }
            },
            "Create_Task_Kickoff": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Tasks",
                  "item/Title": "Schedule and run kickoff call",
                  "item/AtlasClientRefId": "@variables('ClientId')",
                  "item/ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/TaskStatus": {
                    "Value": "Not Started"
                  },
                  "item/Priority": {
                    "Value": "High"
                  },
                  "item/OwnerEmail": "@parameters('hvcg_OpsEmail')",
                  "item/DueDate": "@addDays(variables('StartDate'), 2)",
                  "item/DependsOnTaskKeys": "",
                  "item/TemplateTaskKey": "kickoff",
                  "item/HVCG_IdempotencyKey": "@concat(outputs('Compose_IdempotencyKey'), '|kickoff')"
                }
              },
              "runAfter": {
                "Create_Milestone_OnboardingComplete": [
                  "Succeeded"
                ]
              }
            },
            "Create_Task_CollectDocs": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Tasks",
                  "item/Title": "Collect critical onboarding documents",
                  "item/AtlasClientRefId": "@variables('ClientId')",
                  "item/ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/TaskStatus": {
                    "Value": "Not Started"
                  },
                  "item/Priority": {
                    "Value": "High"
                  },
                  "item/OwnerEmail": "@parameters('hvcg_OpsEmail')",
                  "item/DueDate": "@addDays(variables('StartDate'), 7)",
                  "item/DependsOnTaskKeys": "kickoff",
                  "item/TemplateTaskKey": "collect-critical-docs",
                  "item/HVCG_IdempotencyKey": "@concat(outputs('Compose_IdempotencyKey'), '|collect-critical-docs')"
                }
              },
              "runAfter": {
                "Create_Task_Kickoff": [
                  "Succeeded"
                ]
              }
            },
            "Create_Task_OnboardingReview": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_Tasks",
                  "item/Title": "Complete onboarding review",
                  "item/AtlasClientRefId": "@variables('ClientId')",
                  "item/ProjectIdId": "@outputs('Create_Project')?['body/ID']",
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/TaskStatus": {
                    "Value": "Not Started"
                  },
                  "item/Priority": {
                    "Value": "Medium"
                  },
                  "item/OwnerEmail": "@parameters('hvcg_OpsEmail')",
                  "item/DueDate": "@addDays(variables('StartDate'), 21)",
                  "item/DependsOnTaskKeys": "collect-critical-docs",
                  "item/TemplateTaskKey": "onboarding-review",
                  "item/HVCG_IdempotencyKey": "@concat(outputs('Compose_IdempotencyKey'), '|onboarding-review')"
                }
              },
              "runAfter": {
                "Create_Task_CollectDocs": [
                  "Succeeded"
                ]
              }
            },
            "Log_Success": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_AutomationLogs",
                  "item/Title": "Project created",
                  "item/FlowName": "@workflow()?['name']",
                  "item/Status": {
                    "Value": "Succeeded"
                  },
                  "item/ClientCode": "@triggerBody()?['ClientCode']",
                  "item/IdempotencyKey": "@outputs('Compose_IdempotencyKey')",
                  "item/RelatedList": "HVCG_Projects",
                  "item/RelatedItemId": "@outputs('Create_Project')?['body/ID']",
                  "item/Message": "@concat('Created project id ', string(outputs('Create_Project')?['body/ID']), ' with 3 milestones and 3 tasks')"
                }
              },
              "runAfter": {
                "Create_Task_OnboardingReview": [
                  "Succeeded"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Get_Existing_Project": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
      },
      "api": {
        "name": "shared_sharepointonline"
      }
    },
    "shared_office365": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedoffice365"
      },
      "api": {
        "name": "shared_office365"
      }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_ClientsSiteUrl",
    "hvcg_ExecutiveEmail",
    "hvcg_OpsEmail",
    "hvcg_EnableClientEmails"
  ],
  "acceptanceCriteria": [
    "Flow appears in solution or My flows",
    "Connection references resolved",
    "Test run writes HVCG_AutomationLogs Started/Succeeded or SkippedDuplicate",
    "Project created with ClientId lookup populated, 3 milestones and 3 tasks linked by ProjectId",
    "Idempotent re-run (same client/template/day) logs SkippedDuplicate and creates nothing"
  ]
}

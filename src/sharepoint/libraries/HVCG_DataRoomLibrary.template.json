{
  "libraryTemplateName": "HVCG_DataRoomLibrary",
  "description": "Secure data room document library. External sharing Disabled by default. Anonymous links denied.",
  "versioning": {
    "majorVersionLimit": 500,
    "enableVersioning": true,
    "enableMinorVersions": true
  },
  "contentTypes": ["HVCG_ClientDocument", "HVCG_DataRoomIndex"],
  "folders": [
    "00 - Room Administration",
    "01 - Index and Guides",
    "02 - Corporate",
    "03 - Financials",
    "04 - Tax",
    "05 - Banking and Debt",
    "06 - Legal",
    "07 - Contracts",
    "08 - HR and Payroll",
    "09 - Real Estate",
    "10 - Insurance",
    "11 - Models and Analysis",
    "12 - Lender Package",
    "13 - Investor Package",
    "14 - Client Deliverables",
    "15 - Q and A",
    "16 - Approvals",
    "17 - Closed and Archived"
  ],
  "permissions": {
    "breakRoleInheritance": true,
    "copyRoleAssignments": false,
    "externalSharingMode": "Disabled",
    "denyAnonymousLinks": true,
    "denyOrganizationWideLinks": true,
    "grantDefault": [
      {"group": "HVCG-Role-Owner", "role": "Edit"},
      {"group": "HVCG-Role-Administrator", "role": "Full Control"},
      {"group": "HVCG-Role-OperationsManager", "role": "Edit"},
      {"group": "HVCG-Role-ProjectManager", "role": "Edit"},
      {"group": "HVCG-Role-CapitalAdvisor", "role": "Edit"}
    ],
    "grantOptionalClientGroup": {
      "enabledByDefault": false,
      "groupPattern": "HVCG-Client-{ClientCode}",
      "role": "Read",
      "requires": [
        "DataRooms.ExternalAccessAllowed=true",
        "Clients.ExternalAccessAllowed=true",
        "Org sharing policy P-4 approved",
        "HVCG_Approvals type ExternalShare Approved"
      ]
    },
    "forbidden": [
      "Anonymous links",
      "Anyone with the link",
      "Auto-invite guests from flows",
      "Granting Client Contact without ExternalAccessAllowed"
    ]
  },
  "metadataColumns": [
    {"internalName": "ClientCode", "type": "Text", "indexed": true, "required": true},
    {"internalName": "DataRoomKey", "type": "Text", "indexed": true},
    {"internalName": "DocumentCategory", "type": "Choice", "choices": ["Index", "Corporate", "Financial", "Tax", "Legal", "Contract", "Model", "Lender", "Investor", "Deliverable", "Other"]},
    {"internalName": "Sensitivity", "type": "Choice", "choices": ["Internal", "ClientVisible", "Restricted"], "default": "Internal"},
    {"internalName": "PortalVisible", "type": "Boolean", "default": false},
    {"internalName": "ReceivedDate", "type": "DateTime"},
    {"internalName": "ExpirationDate", "type": "DateTime"},
    {"internalName": "ReviewStatus", "type": "Choice", "choices": ["Pending", "Accepted", "Rejected", "Superseded"], "default": "Pending"},
    {"internalName": "SubmittedBy", "type": "Text"}
  ],
  "sharingControls": {
    "default": "Disabled",
    "maxGuestLinkDays": 30,
    "requireSpecificPeople": true,
    "requireApprovalType": "ExternalShare",
    "logTo": ["HVCG_PortalAuditLog", "21 - Communications"]
  }
}

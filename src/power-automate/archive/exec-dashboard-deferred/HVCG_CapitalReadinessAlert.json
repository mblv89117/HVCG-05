{
  "flowName": "HVCG_CapitalReadinessAlert",
  "displayName": "HVCG_CapitalReadinessAlert",
  "module": "Capital",
  "packageVersion": "1.0.0",
  "defaultState": "Off",
  "description": "Daily alert when capital books approach readiness milestones (Package Complete overdue, or FundingStatus Identified >14 days without First Outreach).",
  "purpose": "capital-readiness alerts",
  "trigger": {
    "type": "Recurrence",
    "schedule": "Daily 09:00 America/Los_Angeles"
  },
  "connections": [
    "SharePoint",
    "Outlook",
    "Teams"
  ],
  "relatedModule": "Capital",
  "owner": "HVCG Ops Automation",
  "documentationLink": "docs/automation/AUTOMATION_INVENTORY.md#hvcg_capitalreadinessalert",
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "pattern": "cap-ready|{CapitalOpportunityId}|{BusinessDate}",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [
    "Capital Advisor / Ops internal",
    "Teams requires OA-CAP-01 + feature flag"
  ],
  "outboundPolicy": {
    "teamsEnabledByDefault": false,
    "featureFlag": "HVCG_CRM_ENABLE_TEAMS_NOTIFY",
    "emailEnabledByDefault": true,
    "recipientMode": "capitalAdvisorInternal",
    "forbidden": [
      "Client email",
      "Package file bodies in notify payload"
    ]
  },
  "steps": [
    {
      "id": 1,
      "action": "LogStart"
    },
    {
      "id": 2,
      "action": "GetOpenCapitalBooks"
    },
    {
      "id": 3,
      "action": "EvaluateReadinessRules"
    },
    {
      "id": 4,
      "action": "NotifyCapitalAdvisor"
    },
    {
      "id": 5,
      "action": "OptionalTeamsCapitalTestChannel"
    },
    {
      "id": 6,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "notifyEmailEnv": "HVCG_OPS_EMAIL",
    "maxRetries": 3,
    "retryDelaySeconds": 60,
    "outlookSend": false
  },
  "loopPrevention": [
    "Does not change FundingStatus",
    "One alert per capital book per day"
  ],
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_OPS_EMAIL",
    "HVCG_TEAMS_CAPITAL_CHANNEL_ID",
    "HVCG_CRM_ENABLE_TEAMS_NOTIFY"
  ],
  "rollbackOrDisable": "Turn Off"
}

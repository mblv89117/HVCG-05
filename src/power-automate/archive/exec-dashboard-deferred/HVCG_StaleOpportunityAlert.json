{
  "flowName": "HVCG_StaleOpportunityAlert",
  "displayName": "HVCG_StaleOpportunityAlert",
  "module": "OpportunityCRM",
  "packageVersion": "1.0.0",
  "defaultState": "Off",
  "description": "Daily alert when open opportunities have NextActionDate past or Stage idle >14 days without activity.",
  "purpose": "stale-opportunity alerts",
  "trigger": {
    "type": "Recurrence",
    "schedule": "Daily 08:30 America/Los_Angeles"
  },
  "connections": [
    "SharePoint",
    "Outlook",
    "Teams"
  ],
  "relatedModule": "OpportunityCRM",
  "owner": "HVCG Ops Automation",
  "documentationLink": "docs/automation/AUTOMATION_INVENTORY.md#hvcg_staleopportunityalert",
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "pattern": "stale-opp|{OpportunityId}|{BusinessDate}",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [
    "Internal sales/ops only",
    "Teams posts require HVCG_CRM_ENABLE_TEAMS_NOTIFY=true and OA-CRM gate"
  ],
  "outboundPolicy": {
    "teamsEnabledByDefault": false,
    "featureFlag": "HVCG_CRM_ENABLE_TEAMS_NOTIFY",
    "emailEnabledByDefault": true,
    "recipientMode": "salesOwnerInternal",
    "forbidden": [
      "Client email",
      "Company-wide Teams"
    ]
  },
  "steps": [
    {
      "id": 1,
      "action": "LogStart"
    },
    {
      "id": 2,
      "action": "GetOpenOpportunities",
      "params": {
        "list": "HVCG_Opportunities",
        "filter": "Stage not in Won,Lost"
      }
    },
    {
      "id": 3,
      "action": "FilterStale",
      "params": {
        "rules": [
          "NextActionDate < Today",
          "Modified older than 14 days"
        ]
      }
    },
    {
      "id": 4,
      "action": "NotifySalesOwner"
    },
    {
      "id": 5,
      "action": "OptionalTeamsCrmTestChannel"
    },
    {
      "id": 6,
      "action": "CreateOpportunityActivity",
      "params": {
        "ActivityType": "StaleAlert"
      }
    },
    {
      "id": 7,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "notifyEmailEnv": "HVCG_OPS_EMAIL",
    "maxRetries": 3,
    "retryDelaySeconds": 60,
    "outlookSend": false
  },
  "loopPrevention": [
    "Do not change Stage",
    "One alert per opportunity per business day",
    "Activity write uses distinct ActivityType"
  ],
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_OPS_EMAIL",
    "HVCG_CRM_ENABLE_TEAMS_NOTIFY",
    "HVCG_TEAMS_CRM_CHANNEL_ID"
  ],
  "rollbackOrDisable": "Turn Off; delete same-day StaleAlert activities if needed"
}

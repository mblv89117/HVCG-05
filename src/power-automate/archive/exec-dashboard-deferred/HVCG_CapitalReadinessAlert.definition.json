{
  "name": "HVCG_CapitalReadinessAlert",
  "displayName": "HVCG_CapitalReadinessAlert",
  "description": "Daily alert when capital books approach readiness milestones (Package Complete overdue, or FundingStatus Identified >14 days without First Outreach).",
  "owner": "automation",
  "module": "Capital",
  "packageVersion": "1.0.0",
  "defaultState": "Off",
  "documentationLink": "docs/automation/AUTOMATION_INVENTORY.md#hvcg_capitalreadinessalert",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "hvcg_CommandCenterSiteUrl": {
        "type": "String"
      },
      "hvcg_OpsEmail": {
        "type": "String"
      }
    },
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 1,
          "timeZone": "Pacific Standard Time"
        }
      }
    },
    "actions": {
      "Log_Start": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Started",
            "item/FlowName": "HVCG_CapitalReadinessAlert",
            "item/Status": "Started"
          }
        },
        "runAfter": {},
        "runtimeConfiguration": {
          "retryPolicy": {
            "type": "fixed",
            "count": 3,
            "interval": "PT1M"
          }
        }
      },
      "Compose_Implement_Build_Sheet": {
        "type": "Compose",
        "inputs": "Implement steps from src/power-automate/flows/HVCG_CapitalReadinessAlert.json. Honor idempotency, loopPrevention, outboundPolicy, and humanApproval.",
        "runAfter": {
          "Log_Start": [
            "Succeeded"
          ]
        }
      },
      "Log_Success": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Succeeded",
            "item/FlowName": "HVCG_CapitalReadinessAlert",
            "item/Status": "Succeeded"
          }
        },
        "runAfter": {
          "Compose_Implement_Build_Sheet": [
            "Succeeded"
          ]
        }
      },
      "Log_Failure": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Failed",
            "item/FlowName": "HVCG_CapitalReadinessAlert",
            "item/Status": "Failed",
            "item/Message": "@{coalesce(actions('Compose_Implement_Build_Sheet')?['error']?['message'], 'Flow stage failed')}"
          }
        },
        "runAfter": {
          "Compose_Implement_Build_Sheet": [
            "Failed",
            "TimedOut"
          ],
          "Log_Start": [
            "Failed",
            "TimedOut"
          ]
        }
      },
      "Failure_Notify_Admin": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_office365",
            "operationId": "SendEmailV2",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
          },
          "parameters": {
            "emailMessage/To": "@parameters('hvcg_OpsEmail')",
            "emailMessage/Subject": "FLOW FAILED: HVCG_CapitalReadinessAlert",
            "emailMessage/Body": "<p>Flow <b>HVCG_CapitalReadinessAlert</b> failed. Check HVCG_AutomationLogs and Maker run history.</p>",
            "emailMessage/Importance": "High"
          }
        },
        "runAfter": {
          "Log_Failure": [
            "Succeeded",
            "Failed",
            "Skipped"
          ]
        }
      }
    },
    "outputs": {}
  }
}

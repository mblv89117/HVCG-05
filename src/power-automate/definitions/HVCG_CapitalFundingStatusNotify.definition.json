{
  "name": "HVCG_CapitalFundingStatusNotify",
  "displayName": "HVCG_CapitalFundingStatusNotify",
  "description": "Capital FundingStatus change \u2192 activity, sales bridge, gated Teams (CRM package 1.1.0) (WO6 recurrence scanner) (WO6 recurrence scanner)",
  "defaultState": "Off",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "hvcg_CommandCenterSiteUrl": {
        "type": "String",
        "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-CommandCenter-Dev"
      },
      "hvcg_CrmEnableTeamsNotify": {
        "type": "Bool",
        "defaultValue": false
      }
    },
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        }
      }
    },
    "actions": {
      "Get_Capital_Opps": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_CapitalOpportunities",
            "$orderby": "Modified desc",
            "$top": 15
          }
        }
      },
      "Apply_to_each_Cap": {
        "type": "Foreach",
        "foreach": "@outputs('Get_Capital_Opps')?['body/value']",
        "runAfter": {
          "Get_Capital_Opps": [
            "Succeeded"
          ]
        },
        "actions": {
          "Compose_FundingStatus": {
            "type": "Compose",
            "inputs": "@coalesce(items('Apply_to_each_Cap')?['FundingStatus/Value'], items('Apply_to_each_Cap')?['FundingStatus'])"
          },
          "Http_Find_Cap_Activity": {
            "type": "OpenApiConnection",
            "runAfter": {
              "Compose_FundingStatus": [
                "Succeeded"
              ]
            },
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "HttpRequest",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "parameters/method": "GET",
                "parameters/uri": "_api/web/lists/getbytitle('HVCG_OpportunityActivities')/items?$filter=HVCG_IdempotencyKey eq 'cap-status|@{items('Apply_to_each_Cap')?['ID']}|@{outputs('Compose_FundingStatus')}'&$select=Id&$top=1",
                "parameters/headers": {
                  "Accept": "application/json;odata=nometadata"
                }
              }
            }
          },
          "Condition_Create_Cap": {
            "type": "If",
            "runAfter": {
              "Http_Find_Cap_Activity": [
                "Succeeded",
                "Failed"
              ]
            },
            "expression": {
              "or": [
                {
                  "equals": [
                    "@body('Http_Find_Cap_Activity')?['value']?[0]?['Id']",
                    "@null"
                  ]
                },
                {
                  "equals": [
                    "@length(coalesce(body('Http_Find_Cap_Activity')?['value'], createArray()))",
                    0
                  ]
                }
              ]
            },
            "actions": {
              "Log_Start": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_AutomationLogs",
                    "item/Title": "Started",
                    "item/FlowName": "HVCG_CapitalFundingStatusNotify",
                    "item/Status": {
                      "Value": "Started"
                    },
                    "item/Message": "Capital @{items('Apply_to_each_Cap')?['ID']} @{outputs('Compose_FundingStatus')}"
                  }
                }
              },
              "Create_Funding_Activity": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Log_Start": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_OpportunityActivities",
                    "item/Title": "FundingStatus \u2192 @{outputs('Compose_FundingStatus')}",
                    "item/ActivityType": {
                      "Value": "FundingUpdate"
                    },
                    "item/NewStage": "@outputs('Compose_FundingStatus')",
                    "item/OwnerEmail": "@coalesce(items('Apply_to_each_Cap')?['OwnerEmail'], 'manny@highvaluecapitalgroup.com')",
                    "item/ActivityDate": "@utcNow()",
                    "item/HVCG_IdempotencyKey": "cap-status|@{items('Apply_to_each_Cap')?['ID']}|@{outputs('Compose_FundingStatus')}"
                  }
                }
              },
              "Notify_Gated": {
                "type": "Compose",
                "runAfter": {
                  "Create_Funding_Activity": [
                    "Succeeded",
                    "Failed"
                  ]
                },
                "inputs": "Teams notify gated false"
              },
              "Log_Success": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Notify_Gated": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_AutomationLogs",
                    "item/Title": "Succeeded",
                    "item/FlowName": "HVCG_CapitalFundingStatusNotify",
                    "item/Status": {
                      "Value": "Succeeded"
                    },
                    "item/RelatedList": "HVCG_CapitalOpportunities",
                    "item/RelatedItemId": "@items('Apply_to_each_Cap')?['ID']",
                    "item/Message": "@concat('Funding status activity for capital ', string(items('Apply_to_each_Cap')?['ID']), ' \u2192 ', string(outputs('Compose_FundingStatus')))"
                  }
                }
              }
            },
            "else": {
              "actions": {
                "Skip_Cap_Exists": {
                  "type": "Compose",
                  "inputs": "Funding activity exists"
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
      },
      "api": {
        "name": "shared_sharepointonline"
      }
    },
    "shared_teams": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedteams"
      },
      "api": {
        "name": "shared_teams"
      }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_TeamsCapitalChannelId",
    "hvcg_TeamsCapitalChannelGroupId",
    "hvcg_ExecutiveEmail",
    "hvcg_CrmTestRecipient",
    "hvcg_CrmEnableTeamsNotify"
  ],
  "outboundPolicy": {
    "teamsEnabledByDefault": false,
    "emailEnabledByDefault": false,
    "recipientMode": "testOnly"
  },
  "buildSheet": "src/power-automate/flows/HVCG_CapitalFundingStatusNotify.json",
  "capitalHandoffBridge": {
    "InFunding": [
      "Term Sheet",
      "Due Diligence",
      "Committed"
    ],
    "Funded": [
      "Closed"
    ],
    "Declined": [
      "Declined"
    ]
  },
  "acceptanceCriteria": [
    "Imported Off; SharePoint + Teams refs resolve",
    "FundingUpdate activity written with idempotency key",
    "Linked Opportunity bridge statuses update per map",
    "Teams only when flag true on capital test channel"
  ]
}

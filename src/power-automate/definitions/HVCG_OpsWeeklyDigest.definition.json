{
  "name": "HVCG_OpsWeeklyDigest",
  "displayName": "HVCG_OpsWeeklyDigest",
  "description": "Monday ops dashboard digest + unowned/blocked alerts",
  "defaultState": "Off",
  "module": "OperationsHub",
  "packageVersion": "1.0.0",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "hvcg_CommandCenterSiteUrl": {
        "type": "String"
      },
      "hvcg_OpsEmail": {
        "type": "String",
        "defaultValue": ""
      },
      "hvcg_ExecutiveEmail": {
        "type": "String",
        "defaultValue": ""
      },
      "hvcg_OpsEnableEmailNotify": {
        "type": "Bool",
        "defaultValue": false
      }
    },
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Week",
          "interval": 1,
          "schedule": {
            "weekDays": [
              "Monday"
            ]
          },
          "startTime": "2026-01-05T08:00:00",
          "timeZone": "Pacific Standard Time"
        }
      }
    },
    "actions": {
      "Log_Start": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Started",
            "item/FlowName": "HVCG_OpsWeeklyDigest",
            "item/Status": "Started"
          }
        },
        "runAfter": {}
      },
      "Compose_Work": {
        "type": "Compose",
        "inputs": "Aggregate renewals, pending approvals, unowned records, blocked projects, open ops alerts; email Ops if flag enabled.",
        "runAfter": {
          "Log_Start": [
            "Succeeded"
          ]
        }
      },
      "Log_Success": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "HVCG_OpsWeeklyDigest completed scaffold",
            "item/FlowName": "HVCG_OpsWeeklyDigest",
            "item/Status": "Succeeded"
          }
        },
        "runAfter": {
          "Compose_Work": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
      },
      "api": {
        "name": "shared_sharepointonline"
      }
    },
    "shared_office365": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedoffice365"
      },
      "api": {
        "name": "shared_office365"
      }
    },
    "shared_approvals": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedapprovals"
      },
      "api": {
        "name": "shared_approvals-1.0"
      }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_OpsEmail",
    "hvcg_ExecutiveEmail",
    "hvcg_OpsEnableEmailNotify"
  ],
  "acceptanceCriteria": [
    "Flow appears in solution or My flows with defaultState Off",
    "Connection references resolved (SharePoint; Outlook/Approvals as required)",
    "Test run writes HVCG_AutomationLogs Started/Succeeded or SkippedDuplicate",
    "Idempotent re-run does not duplicate alerts or approval rows"
  ]
}

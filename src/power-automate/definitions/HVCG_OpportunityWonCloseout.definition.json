{
  "name": "HVCG_OpportunityWonCloseout",
  "displayName": "HVCG_OpportunityWonCloseout",
  "description": "Won-deal closeout and capital handoff (CRM package 1.1.0) (WO6 recurrence scanner) (WO6 recurrence scanner)",
  "defaultState": "Off",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "hvcg_CommandCenterSiteUrl": {
        "type": "String",
        "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-CommandCenter-Dev"
      },
      "hvcg_CrmEnableTeamsNotify": {
        "type": "Bool",
        "defaultValue": false
      }
    },
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        }
      }
    },
    "actions": {
      "Get_Won_Opportunities": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_Opportunities",
            "$filter": "Stage eq 'Won'",
            "$top": 20
          }
        }
      },
      "Apply_to_each_Won": {
        "type": "Foreach",
        "foreach": "@outputs('Get_Won_Opportunities')?['body/value']",
        "runAfter": {
          "Get_Won_Opportunities": [
            "Succeeded"
          ]
        },
        "actions": {
          "Http_Find_Won_Activity": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "HttpRequest",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "parameters/method": "GET",
                "parameters/uri": "_api/web/lists/getbytitle('HVCG_OpportunityActivities')/items?$filter=HVCG_IdempotencyKey eq 'act-opp-won|@{items('Apply_to_each_Won')?['ID']}'&$select=Id&$top=1",
                "parameters/headers": {
                  "Accept": "application/json;odata=nometadata"
                }
              }
            }
          },
          "Condition_Create_Won": {
            "type": "If",
            "runAfter": {
              "Http_Find_Won_Activity": [
                "Succeeded",
                "Failed"
              ]
            },
            "expression": {
              "or": [
                {
                  "equals": [
                    "@body('Http_Find_Won_Activity')?['value']?[0]?['Id']",
                    "@null"
                  ]
                },
                {
                  "equals": [
                    "@length(coalesce(body('Http_Find_Won_Activity')?['value'], createArray()))",
                    0
                  ]
                }
              ]
            },
            "actions": {
              "Log_Start": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_AutomationLogs",
                    "item/Title": "Started",
                    "item/FlowName": "HVCG_OpportunityWonCloseout",
                    "item/Status": {
                      "Value": "Started"
                    },
                    "item/Message": "Won opp @{items('Apply_to_each_Won')?['ID']}"
                  }
                }
              },
              "Create_Won_Activity": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Log_Start": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_OpportunityActivities",
                    "item/Title": "Opportunity marked Won",
                    "item/ActivityType": {
                      "Value": "StageChange"
                    },
                    "item/NewStage": "Won",
                    "item/ActivityDate": "@utcNow()",
                    "item/OwnerEmail": "@coalesce(items('Apply_to_each_Won')?['SalesOwnerEmail'], items('Apply_to_each_Won')?['OwnerEmail'], 'manny@highvaluecapitalgroup.com')",
                    "item/OpportunityId": {
                      "Id": "@items('Apply_to_each_Won')?['ID']"
                    },
                    "item/HVCG_IdempotencyKey": "act-opp-won|@{items('Apply_to_each_Won')?['ID']}"
                  }
                }
              },
              "Ensure_WinLoss": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Create_Won_Activity": [
                    "Succeeded",
                    "Failed"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_WinLossAnalyses",
                    "item/Title": "Won analysis @{items('Apply_to_each_Won')?['Title']}",
                    "item/Result": {
                      "Value": "Won"
                    },
                    "item/OpportunityId": {
                      "Id": "@items('Apply_to_each_Won')?['ID']"
                    },
                    "item/HVCG_IdempotencyKey": "winloss|@{items('Apply_to_each_Won')?['ID']}|Won"
                  }
                }
              },
              "Patch_Won_Fields": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Ensure_WinLoss": [
                    "Succeeded",
                    "Failed"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_Opportunities",
                    "id": "@items('Apply_to_each_Won')?['ID']",
                    "item/Title": "@items('Apply_to_each_Won')?['Title']",
                    "item/WinLossStatus": {
                      "Value": "Won"
                    },
                    "item/Stage": {
                      "Value": "Won"
                    },
                    "item/ForecastCategory": {
                      "Value": "Closed"
                    },
                    "item/Probability": 100,
                    "item/CopilotSummary": "Won closeout processed"
                  }
                }
              },
              "Notify_Gated": {
                "type": "Compose",
                "runAfter": {
                  "Patch_Won_Fields": [
                    "Succeeded",
                    "Failed"
                  ]
                },
                "inputs": "Teams notify gated false"
              },
              "Log_Success": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Notify_Gated": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PostItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                    "table": "HVCG_AutomationLogs",
                    "item/Title": "Succeeded",
                    "item/FlowName": "HVCG_OpportunityWonCloseout",
                    "item/Status": {
                      "Value": "Succeeded"
                    },
                    "item/RelatedList": "HVCG_Opportunities",
                    "item/RelatedItemId": "@items('Apply_to_each_Won')?['ID']",
                    "item/Message": "@concat('Won closeout for opp ', string(items('Apply_to_each_Won')?['ID']))"
                  }
                }
              }
            },
            "else": {
              "actions": {
                "Skip_Won_Exists": {
                  "type": "Compose",
                  "inputs": "Won activity exists"
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
      },
      "api": {
        "name": "shared_sharepointonline"
      }
    },
    "shared_teams": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedteams"
      },
      "api": {
        "name": "shared_teams"
      }
    },
    "shared_office365": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedoffice365"
      },
      "api": {
        "name": "shared_office365"
      }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_TeamsCrmChannelId",
    "hvcg_TeamsCrmChannelGroupId",
    "hvcg_TeamsCapitalChannelId",
    "hvcg_TeamsCapitalChannelGroupId",
    "hvcg_ExecutiveEmail",
    "hvcg_CrmTestRecipient",
    "hvcg_CrmEnableTeamsNotify"
  ],
  "outboundPolicy": {
    "teamsEnabledByDefault": false,
    "emailEnabledByDefault": false,
    "recipientMode": "testOnly",
    "outlookSend": false
  },
  "buildSheet": "src/power-automate/flows/HVCG_OpportunityWonCloseout.json",
  "fundingMilestoneTypes": [
    "Package Complete",
    "First Outreach",
    "Term Sheet",
    "Appraisal",
    "Commitment",
    "Closing",
    "Funding"
  ],
  "acceptanceCriteria": [
    "Imported Off; connection refs resolve",
    "Won path stamps Closed forecast and creates WinLoss stub once",
    "Capital handoff requires ClientId; milestones use schema MilestoneType choices",
    "No Teams unless hvcg_CrmEnableTeamsNotify=true on test channels"
  ]
}

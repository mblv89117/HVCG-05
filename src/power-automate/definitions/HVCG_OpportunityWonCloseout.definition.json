{
  "name": "HVCG_OpportunityWonCloseout",
  "displayName": "HVCG_OpportunityWonCloseout",
  "description": "Won-deal closeout and capital handoff (CRM package 1.1.0)",
  "defaultState": "Off",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": { "defaultValue": {}, "type": "SecureObject" },
      "$connections": { "defaultValue": {}, "type": "Object" },
      "hvcg_CommandCenterSiteUrl": { "type": "String" },
      "hvcg_TeamsCrmChannelId": { "type": "String", "defaultValue": "" },
      "hvcg_TeamsCrmChannelGroupId": { "type": "String", "defaultValue": "" },
      "hvcg_TeamsCapitalChannelId": { "type": "String", "defaultValue": "" },
      "hvcg_TeamsCapitalChannelGroupId": { "type": "String", "defaultValue": "" },
      "hvcg_CrmEnableTeamsNotify": { "type": "Bool", "defaultValue": false },
      "hvcg_CrmTestRecipient": { "type": "String", "defaultValue": "" }
    },
    "triggers": {
      "When_opportunity_modified": {
        "type": "OpenApiConnectionWebhook",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetOnUpdatedItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_Opportunities"
          },
          "splitOn": "@triggerOutputs()?['body/value']"
        }
      }
    },
    "actions": {
      "Log_Start": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item/Title": "Started",
            "item/FlowName": "HVCG_OpportunityWonCloseout",
            "item/Status": "Started"
          }
        },
        "runAfter": {}
      },
      "Condition_Won": {
        "type": "If",
        "expression": {
          "or": [
            { "equals": ["@triggerOutputs()?['body/Stage']", "Won"] },
            { "equals": ["@triggerOutputs()?['body/WinLossStatus']", "Won"] }
          ]
        },
        "actions": {
          "Stamp_Won_Fields": {
            "type": "Compose",
            "inputs": "Patch Opportunity: WinLossStatus=Won, Stage=Won, WonDate=utcNow if empty, ForecastCategory=Closed, Probability=100, HVCG_IdempotencyKey=opp-won|{ID}"
          },
          "Ensure_WinLoss_Stub": {
            "type": "Compose",
            "inputs": "FindOrCreate HVCG_WinLossAnalyses Result=Won OpportunityId={ID}; marker winloss|{ID}|Won",
            "runAfter": { "Stamp_Won_Fields": ["Succeeded"] }
          },
          "Create_Won_Activity": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PostItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_OpportunityActivities",
                "item/Title": "Opportunity marked Won",
                "item/ActivityType": "StageChange",
                "item/NewStage": "Won",
                "item/ActivityDate": "@utcNow()",
                "item/HVCG_IdempotencyKey": "act-opp-won|@{triggerOutputs()?['body/ID']}"
              }
            },
            "runAfter": { "Ensure_WinLoss_Stub": ["Succeeded"] }
          },
          "Condition_Capital_Handoff": {
            "type": "If",
            "expression": {
              "or": [
                { "equals": ["@triggerOutputs()?['body/OpportunityType']", "Capital Raise"] },
                { "equals": ["@triggerOutputs()?['body/OpportunityType']", "Hybrid"] },
                { "equals": ["@triggerOutputs()?['body/CapitalHandoffStatus']", "Ready"] }
              ]
            },
            "actions": {
              "Compose_Require_ClientId": {
                "type": "Compose",
                "inputs": "If ClientId empty → LogFailureNote and skip; else FindOrCreate HVCG_CapitalOpportunities with CapitalType=Other, FundingStatus=Identified, HandoffSource=SalesWin, TargetAmount=ProposalAmount, key cap-from-opp|{ID}; create FundingMilestones for schema MilestoneTypes; patch Opportunity CapitalOpportunityId + CapitalHandoffStatus=HandedOff"
              },
              "Condition_Capital_Teams": {
                "type": "If",
                "expression": {
                  "and": [{ "equals": ["@parameters('hvcg_CrmEnableTeamsNotify')", true] }]
                },
                "actions": {
                  "Post_Capital_Test_Channel": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_teams",
                        "operationId": "PostMessageToChannel",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                      },
                      "parameters": {
                        "poster": "Flow bot",
                        "location": "Channel",
                        "body/recipient/groupId": "@parameters('hvcg_TeamsCapitalChannelGroupId')",
                        "body/recipient/channelId": "@parameters('hvcg_TeamsCapitalChannelId')",
                        "body/messageBody": "Capital handoff from won deal (test channel only)."
                      }
                    }
                  }
                },
                "runAfter": { "Compose_Require_ClientId": ["Succeeded"] }
              }
            },
            "runAfter": { "Create_Won_Activity": ["Succeeded"] }
          },
          "Condition_Crm_Teams": {
            "type": "If",
            "expression": {
              "and": [{ "equals": ["@parameters('hvcg_CrmEnableTeamsNotify')", true] }]
            },
            "actions": {
              "Post_Crm_Win_Test_Channel": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_teams",
                    "operationId": "PostMessageToChannel",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Channel",
                    "body/recipient/groupId": "@parameters('hvcg_TeamsCrmChannelGroupId')",
                    "body/recipient/channelId": "@parameters('hvcg_TeamsCrmChannelId')",
                    "body/messageBody": "Opportunity won (test channel only)."
                  }
                }
              }
            },
            "runAfter": { "Condition_Capital_Handoff": ["Succeeded", "Skipped", "TimedOut"] }
          },
          "Log_Success": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PostItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_AutomationLogs",
                "item/Title": "Succeeded",
                "item/FlowName": "HVCG_OpportunityWonCloseout",
                "item/Status": "Succeeded"
              }
            },
            "runAfter": { "Condition_Crm_Teams": ["Succeeded", "Skipped", "TimedOut"] }
          }
        },
        "runAfter": { "Log_Start": ["Succeeded"] }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": { "connectionReferenceLogicalName": "hvcg_sharedsharepointonline" },
      "api": { "name": "shared_sharepointonline" }
    },
    "shared_teams": {
      "runtimeSource": "embedded",
      "connection": { "connectionReferenceLogicalName": "hvcg_sharedteams" },
      "api": { "name": "shared_teams" }
    },
    "shared_office365": {
      "runtimeSource": "embedded",
      "connection": { "connectionReferenceLogicalName": "hvcg_sharedoffice365" },
      "api": { "name": "shared_office365" }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_TeamsCrmChannelId",
    "hvcg_TeamsCrmChannelGroupId",
    "hvcg_TeamsCapitalChannelId",
    "hvcg_TeamsCapitalChannelGroupId",
    "hvcg_ExecutiveEmail",
    "hvcg_CrmTestRecipient",
    "hvcg_CrmEnableTeamsNotify"
  ],
  "outboundPolicy": {
    "teamsEnabledByDefault": false,
    "emailEnabledByDefault": false,
    "recipientMode": "testOnly",
    "outlookSend": false
  },
  "buildSheet": "src/power-automate/flows/HVCG_OpportunityWonCloseout.json",
  "fundingMilestoneTypes": [
    "Package Complete",
    "First Outreach",
    "Term Sheet",
    "Appraisal",
    "Commitment",
    "Closing",
    "Funding"
  ],
  "acceptanceCriteria": [
    "Imported Off; connection refs resolve",
    "Won path stamps Closed forecast and creates WinLoss stub once",
    "Capital handoff requires ClientId; milestones use schema MilestoneType choices",
    "No Teams unless hvcg_CrmEnableTeamsNotify=true on test channels"
  ]
}

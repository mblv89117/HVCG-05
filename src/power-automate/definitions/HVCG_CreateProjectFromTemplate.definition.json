{
  "name": "HVCG_CreateProjectFromTemplate",
  "displayName": "HVCG_CreateProjectFromTemplate",
  "description": "Create a delivery project with kickoff milestones and onboarding tasks for a client, linked by ClientId lookup. Idempotent per client/template/day.",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "10.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "hvcg_CommandCenterSiteUrl": {
        "type": "String",
        "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-CommandCenter"
      },
      "hvcg_ClientsSiteUrl": {
        "type": "String",
        "defaultValue": "https://highvaluecapitalgroup.sharepoint.com/sites/HVCG-Clients"
      },
      "hvcg_ExecutiveEmail": {
        "type": "String",
        "defaultValue": "manny@highvaluecapitalgroup.com"
      },
      "hvcg_OpsEmail": {
        "type": "String",
        "defaultValue": "manny@highvaluecapitalgroup.com"
      },
      "hvcg_EnableClientEmails": {
        "type": "Bool",
        "defaultValue": false
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Button",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "ClientCode": {
                "type": "string",
                "title": "ClientCode",
                "description": "Short unique client code, e.g. ACME01"
              },
              "ClientListItemId": {
                "type": "integer",
                "title": "ClientListItemId",
                "description": "Optional HVCG_Clients item Id (skips ClientCode lookup)"
              },
              "TemplateKey": {
                "type": "string",
                "title": "TemplateKey",
                "description": "Project template key (default general-client-onboarding)"
              },
              "StartDate": {
                "type": "string",
                "title": "StartDate",
                "description": "Optional ISO date the project starts (defaults to today)"
              }
            },
            "required": [
              "ClientCode"
            ]
          }
        }
      }
    },
    "actions": {
      "Log_Start": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "PostItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_AutomationLogs",
            "item": {
              "Title": "Started",
              "FlowName": "@workflow()?['name']",
              "Status": {
                "Value": "Started"
              },
              "ClientCode": "@triggerBody()?['ClientCode']"
            }
          }
        },
        "runAfter": {}
      },
      "Init_ClientId": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "ClientId",
              "type": "integer",
              "value": "@coalesce(triggerBody()?['ClientListItemId'], 0)"
            }
          ]
        },
        "runAfter": {
          "Log_Start": [
            "Succeeded"
          ]
        }
      },
      "Init_TemplateKey": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "TemplateKey",
              "type": "string",
              "value": "@coalesce(triggerBody()?['TemplateKey'], 'general-client-onboarding')"
            }
          ]
        },
        "runAfter": {
          "Init_ClientId": [
            "Succeeded"
          ]
        }
      },
      "Init_StartDate": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "StartDate",
              "type": "string",
              "value": "@coalesce(triggerBody()?['StartDate'], utcNow())"
            }
          ]
        },
        "runAfter": {
          "Init_TemplateKey": [
            "Succeeded"
          ]
        }
      },
      "Compose_IdempotencyKey": {
        "type": "Compose",
        "inputs": "@concat('proj|', triggerBody()?['ClientCode'], '|', variables('TemplateKey'), '|', formatDateTime(utcNow(), 'yyyyMMdd'))",
        "runAfter": {
          "Init_StartDate": [
            "Succeeded"
          ]
        }
      },
      "Condition_NeedClientLookup": {
        "type": "If",
        "expression": {
          "and": [
            {
              "lessOrEquals": [
                "@variables('ClientId')",
                0
              ]
            }
          ]
        },
        "actions": {
          "Get_Client_ByCode": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_Clients",
                "$filter": "ClientCode eq '@{triggerBody()?['ClientCode']}'",
                "$top": 1
              }
            },
            "runAfter": {}
          },
          "Set_ClientId": {
            "type": "SetVariable",
            "inputs": {
              "name": "ClientId",
              "value": "@int(first(outputs('Get_Client_ByCode')?['body/value'])?['ID'])"
            },
            "runAfter": {
              "Get_Client_ByCode": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Compose_IdempotencyKey": [
            "Succeeded"
          ]
        }
      },
      "Get_Existing_Project": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
            "table": "HVCG_Projects",
            "$filter": "HVCG_IdempotencyKey eq '@{outputs('Compose_IdempotencyKey')}'",
            "$top": 1
          }
        },
        "runAfter": {
          "Condition_NeedClientLookup": [
            "Succeeded"
          ]
        }
      },
      "Condition_Duplicate": {
        "type": "If",
        "expression": {
          "and": [
            {
              "greater": [
                "@length(coalesce(outputs('Get_Existing_Project')?['body/value'], json('[]')))",
                0
              ]
            }
          ]
        },
        "actions": {
          "Log_Skipped": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PostItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                "table": "HVCG_AutomationLogs",
                "item": {
                  "Title": "Project SkippedDuplicate",
                  "FlowName": "@workflow()?['name']",
                  "Status": {
                    "Value": "SkippedDuplicate"
                  },
                  "ClientCode": "@triggerBody()?['ClientCode']",
                  "IdempotencyKey": "@outputs('Compose_IdempotencyKey')",
                  "RelatedList": "HVCG_Projects",
                  "RelatedItemId": "@int(first(outputs('Get_Existing_Project')?['body/value'])?['ID'])"
                }
              }
            },
            "runAfter": {}
          },
          "Terminate_Skipped": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Succeeded"
            },
            "runAfter": {
              "Log_Skipped": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Create_Project": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_Projects')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"Title\":\"@{concat(triggerBody()?['ClientCode'], ' - ', variables('TemplateKey'))}\",\"AtlasClientRefId\":@{variables('ClientId')},\"ClientCode\":\"@{triggerBody()?['ClientCode']}\",\"ProjectTemplateKey\":\"@{variables('TemplateKey')}\",\"ProjectStatus\":\"Not Started\",\"ProjectHealth\":\"Green\",\"ProjectOwnerEmail\":\"@{parameters('hvcg_OpsEmail')}\",\"StartDate\":\"@{variables('StartDate')}\",\"TargetEndDate\":\"@{addDays(variables('StartDate'), 21)}\",\"HVCG_IdempotencyKey\":\"@{outputs('Compose_IdempotencyKey')}\"}"
                }
              },
              "runAfter": {}
            },
            "Create_Milestone_Kickoff": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_Milestones')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"Title\":\"Kickoff completed\",\"ProjectIdId\":@{coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID'])},\"ClientCode\":\"@{triggerBody()?['ClientCode']}\",\"DueDate\":\"@{addDays(variables('StartDate'), 2)}\",\"Status\":\"Pending\",\"IsCritical\":false}"
                }
              },
              "runAfter": {
                "Create_Project": [
                  "Succeeded"
                ]
              }
            },
            "Create_Milestone_CriticalDocs": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_Milestones')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"Title\":\"Critical documents collected\",\"ProjectIdId\":@{coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID'])},\"ClientCode\":\"@{triggerBody()?['ClientCode']}\",\"DueDate\":\"@{addDays(variables('StartDate'), 7)}\",\"Status\":\"Pending\",\"IsCritical\":true}"
                }
              },
              "runAfter": {
                "Create_Milestone_Kickoff": [
                  "Succeeded"
                ]
              }
            },
            "Create_Milestone_OnboardingComplete": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_Milestones')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"Title\":\"Onboarding complete\",\"ProjectIdId\":@{coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID'])},\"ClientCode\":\"@{triggerBody()?['ClientCode']}\",\"DueDate\":\"@{addDays(variables('StartDate'), 21)}\",\"Status\":\"Pending\",\"IsCritical\":false}"
                }
              },
              "runAfter": {
                "Create_Milestone_CriticalDocs": [
                  "Succeeded"
                ]
              }
            },
            "Create_Task_Kickoff": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_Tasks')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"Title\":\"Schedule and run kickoff call\",\"AtlasClientRefId\":@{variables('ClientId')},\"ProjectIdId\":@{coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID'])},\"ClientCode\":\"@{triggerBody()?['ClientCode']}\",\"TaskStatus\":\"Not Started\",\"Priority\":\"High\",\"OwnerEmail\":\"@{parameters('hvcg_OpsEmail')}\",\"DueDate\":\"@{addDays(variables('StartDate'), 2)}\",\"DependsOnTaskKeys\":\"\",\"TemplateTaskKey\":\"kickoff\",\"HVCG_IdempotencyKey\":\"@{concat(outputs('Compose_IdempotencyKey'), '|kickoff')}\"}"
                }
              },
              "runAfter": {
                "Create_Milestone_OnboardingComplete": [
                  "Succeeded"
                ]
              }
            },
            "Create_Task_CollectDocs": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_Tasks')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"Title\":\"Collect critical onboarding documents\",\"AtlasClientRefId\":@{variables('ClientId')},\"ProjectIdId\":@{coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID'])},\"ClientCode\":\"@{triggerBody()?['ClientCode']}\",\"TaskStatus\":\"Not Started\",\"Priority\":\"High\",\"OwnerEmail\":\"@{parameters('hvcg_OpsEmail')}\",\"DueDate\":\"@{addDays(variables('StartDate'), 7)}\",\"DependsOnTaskKeys\":\"kickoff\",\"TemplateTaskKey\":\"collect-critical-docs\",\"HVCG_IdempotencyKey\":\"@{concat(outputs('Compose_IdempotencyKey'), '|collect-critical-docs')}\"}"
                }
              },
              "runAfter": {
                "Create_Task_Kickoff": [
                  "Succeeded"
                ]
              }
            },
            "Create_Task_OnboardingReview": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('HVCG_Tasks')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"Title\":\"Complete onboarding review\",\"AtlasClientRefId\":@{variables('ClientId')},\"ProjectIdId\":@{coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID'])},\"ClientCode\":\"@{triggerBody()?['ClientCode']}\",\"TaskStatus\":\"Not Started\",\"Priority\":\"Medium\",\"OwnerEmail\":\"@{parameters('hvcg_OpsEmail')}\",\"DueDate\":\"@{addDays(variables('StartDate'), 21)}\",\"DependsOnTaskKeys\":\"collect-critical-docs\",\"TemplateTaskKey\":\"onboarding-review\",\"HVCG_IdempotencyKey\":\"@{concat(outputs('Compose_IdempotencyKey'), '|onboarding-review')}\"}"
                }
              },
              "runAfter": {
                "Create_Task_CollectDocs": [
                  "Succeeded"
                ]
              }
            },
            "Log_Success": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('hvcg_CommandCenterSiteUrl')",
                  "table": "HVCG_AutomationLogs",
                  "item": {
                    "Title": "Project created",
                    "FlowName": "@workflow()?['name']",
                    "Status": {
                      "Value": "Succeeded"
                    },
                    "ClientCode": "@triggerBody()?['ClientCode']",
                    "IdempotencyKey": "@outputs('Compose_IdempotencyKey')",
                    "RelatedList": "HVCG_Projects",
                    "RelatedItemId": "@int(coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID']))",
                    "Message": "@concat('Created project id ', string(coalesce(outputs('Create_Project')?['body/Id'], outputs('Create_Project')?['body/ID'])), ' with 3 milestones and 3 tasks')"
                  }
                }
              },
              "runAfter": {
                "Create_Task_OnboardingReview": [
                  "Succeeded"
                ]
              }
            }
          }
        },
        "runAfter": {
          "Get_Existing_Project": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedsharepointonline"
      },
      "api": {
        "name": "shared_sharepointonline"
      }
    },
    "shared_office365": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "hvcg_sharedoffice365"
      },
      "api": {
        "name": "shared_office365"
      }
    }
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_ClientsSiteUrl",
    "hvcg_ExecutiveEmail",
    "hvcg_OpsEmail",
    "hvcg_EnableClientEmails"
  ],
  "acceptanceCriteria": [
    "Flow appears in solution or My flows",
    "Connection references resolved",
    "Test run writes HVCG_AutomationLogs Started/Succeeded or SkippedDuplicate",
    "Project created with ClientId lookup populated, 3 milestones and 3 tasks linked by ProjectId",
    "Idempotent re-run (same client/template/day) logs SkippedDuplicate and creates nothing"
  ]
}

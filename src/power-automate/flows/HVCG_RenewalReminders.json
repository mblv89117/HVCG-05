{
  "flowName": "HVCG_RenewalReminders",
  "displayName": "HVCG_RenewalReminders",
  "description": "Creates renewal tasks 60/30/14 days before RenewalDate.",
  "trigger": {
    "type": "Recurrence",
    "schedule": "Daily 07:00 America/Los_Angeles"
  },
  "connections": [
    "SharePoint",
    "Outlook"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [],
  "steps": [
    {
      "id": 1,
      "action": "GetClientsInRenewalWindows",
      "params": {
        "windows": [
          60,
          30,
          14
        ]
      }
    },
    {
      "id": 2,
      "action": "CreateIdempotentRenewalTasks"
    },
    {
      "id": 3,
      "action": "NotifyRelationshipOwnerAt14Days"
    },
    {
      "id": 4,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60,
    "notifyEmailEnv": "HVCG_OPS_EMAIL"
  },
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_CLIENTS_HUB_URL",
    "HVCG_OPS_EMAIL",
    "HVCG_EXECUTIVE_EMAIL",
    "HVCG_ENABLE_CLIENT_EMAILS"
  ],
  "owner": "HVCG Ops Automation",
  "defaultState": "Off",
  "documentationLink": "docs/automation/AUTOMATION_INVENTORY.md#hvcg_renewalreminders",
  "auditHistory": {
    "list": "HVCG_AutomationLogs",
    "required": true
  },
  "connectionReferences": [
    "hvcg_sharedsharepointonline",
    "hvcg_sharedoffice365"
  ],
  "rollbackOrDisable": "Turn Off in Maker; leave AutomationLogs intact",
  "usedByModules": [
    "Revenue Systems",
    "Executive Intelligence"
  ],
  "releaseStatus": "Supporting",
  "productionChecklist": {
    "owner": true,
    "documentation": true,
    "retryHandling": true,
    "errorHandling": true,
    "notifications": true,
    "auditHistory": true,
    "connectionReferences": true,
    "environmentVariables": true,
    "makerUat": false,
    "qaGo": false,
    "productionEnabled": false
  }
}

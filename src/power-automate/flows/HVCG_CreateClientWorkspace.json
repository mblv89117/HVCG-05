{
  "flowName": "HVCG_CreateClientWorkspace",
  "displayName": "HVCG_CreateClientWorkspace",
  "description": "Creates client library, folders 00-23, permissions, updates client URL.",
  "trigger": {
    "type": "ManualOrChild",
    "inputs": [
      "ClientCode",
      "ClientDisplayName",
      "ClientListItemId"
    ]
  },
  "connections": [
    "SharePoint"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [],
  "steps": [
    {
      "id": 1,
      "action": "EnsureSecurityGroup",
      "params": {
        "name": "HVCG-Client-{ClientCode}"
      }
    },
    {
      "id": 2,
      "action": "CreateDocumentLibrary",
      "params": {
        "site": "HVCG_CLIENTS_HUB_URL",
        "title": "HVCG_{ClientCode}"
      }
    },
    {
      "id": 3,
      "action": "CreateFolders",
      "params": {
        "fromConfig": "documentFolderStructure"
      }
    },
    {
      "id": 4,
      "action": "BreakInheritanceAndGrant"
    },
    {
      "id": 5,
      "action": "UpdateClientSharePointLibraryUrl"
    },
    {
      "id": 6,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60,
    "notifyEmailEnv": "HVCG_OPS_EMAIL"
  },
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_CLIENTS_HUB_URL",
    "HVCG_OPS_EMAIL",
    "HVCG_EXECUTIVE_EMAIL",
    "HVCG_ENABLE_CLIENT_EMAILS"
  ],
  "owner": "HVCG Ops Automation",
  "defaultState": "Off",
  "documentationLink": "docs/automation/AUTOMATION_INVENTORY.md#hvcg_createclientworkspace",
  "auditHistory": {
    "list": "HVCG_AutomationLogs",
    "required": true
  },
  "connectionReferences": [
    "hvcg_sharedsharepointonline"
  ],
  "rollbackOrDisable": "Turn Off in Maker; leave AutomationLogs intact",
  "usedByModules": [
    "Client Portal",
    "Operations Hub"
  ],
  "releaseStatus": "Supporting",
  "productionChecklist": {
    "owner": true,
    "documentation": true,
    "retryHandling": true,
    "errorHandling": true,
    "notifications": true,
    "auditHistory": true,
    "connectionReferences": true,
    "environmentVariables": true,
    "makerUat": false,
    "qaGo": false,
    "productionEnabled": false
  }
}

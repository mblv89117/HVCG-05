{
  "flowName": "HVCG_WeeklyStatusSummary",
  "displayName": "HVCG_WeeklyStatusSummary",
  "description": "Weekly ops digest only. Executive KPI digest is owned by HVCG_ExecutiveWeeklyBrief (no duplicate exec email).",
  "trigger": {
    "type": "Recurrence",
    "schedule": "Monday 06:30 America/Los_Angeles"
  },
  "connections": [
    "SharePoint",
    "Outlook"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [
    "Ops digest only \u2014 do not email HVCG_EXECUTIVE_EMAIL from this flow"
  ],
  "steps": [
    {
      "id": 1,
      "action": "LogStart"
    },
    {
      "id": 2,
      "action": "QueryOpsMetrics"
    },
    {
      "id": 3,
      "action": "EmailOpsDigest"
    },
    {
      "id": 4,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "notifyEmailEnv": "HVCG_OPS_EMAIL",
    "maxRetries": 3,
    "retryDelaySeconds": 60
  },
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_OPS_EMAIL"
  ],
  "defaultState": "Off",
  "owner": "HVCG Ops Automation",
  "relatedModule": "Operations",
  "documentationLink": "docs/automation/AUTOMATION_INVENTORY.md#hvcg_weeklystatussummary",
  "outboundPolicy": {
    "emailEnabledByDefault": true,
    "recipientMode": "opsEmailOnly",
    "forbidden": [
      "Executive KPI digest (use HVCG_ExecutiveWeeklyBrief)",
      "Client email"
    ]
  },
  "connectionReferences": [
    "hvcg_sharedsharepointonline",
    "hvcg_sharedoffice365"
  ],
  "rollbackOrDisable": "Turn Off in Maker",
  "auditHistory": {
    "list": "HVCG_AutomationLogs",
    "required": true
  },
  "usedByModules": [
    "Operations Hub"
  ],
  "execDashboardReleaseRole": "project status notifications (ops)",
  "releaseSet": "executive-dashboard",
  "releaseStatus": "ReleaseCandidate",
  "productionChecklist": {
    "owner": true,
    "documentation": true,
    "retryHandling": true,
    "errorHandling": true,
    "notifications": true,
    "auditHistory": true,
    "connectionReferences": true,
    "environmentVariables": true,
    "makerUat": false,
    "qaGo": false,
    "productionEnabled": false
  }
}

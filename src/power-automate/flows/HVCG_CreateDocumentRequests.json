{
  "flowName": "HVCG_CreateDocumentRequests",
  "displayName": "HVCG_CreateDocumentRequests",
  "description": "Creates HVCG_DocumentRequests records (records only, NO emails). Uses provided DocumentTitles or a standard set of 3. Skips any title that already has an open request for the client.",
  "trigger": {
    "type": "ManualOrChild",
    "inputs": [
      "ClientCode",
      "ClientListItemId",
      "ProjectId",
      "DocumentTitles"
    ]
  },
  "connections": [
    "SharePoint"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "keyPattern": "docreq|{ClientCode}|{Title}",
    "openDuplicateCheck": "ClientCode + Title where RequestStatus not in (Received, Waived, Cancelled)",
    "onDuplicate": "Skip (counted)"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [],
  "emailPolicy": "NONE - records only regardless of hvcg_EnableClientEmails",
  "steps": [
    {
      "id": 1,
      "action": "LogStarted"
    },
    {
      "id": 2,
      "action": "ResolveClientId",
      "params": {
        "list": "HVCG_Clients",
        "byId": "ClientListItemId",
        "elseFilter": "ClientCode eq '{ClientCode}'"
      }
    },
    {
      "id": 3,
      "action": "BuildDocList",
      "params": {
        "default": [
          "Corporate formation and governance documents (Corporate)",
          "Trailing twelve months financial statements (Current Financials)",
          "Most recent business tax return (Tax Returns)"
        ],
        "override": "DocumentTitles -> Category=Other"
      }
    },
    {
      "id": 4,
      "action": "ForeachDoc",
      "params": {
        "checkOpenDuplicate": true,
        "list": "HVCG_DocumentRequests",
        "fields": {
          "AtlasClientRefId": "{ClientId}",
          "ProjectIdId": "{ProjectId?}",
          "ClientCode": "{ClientCode}",
          "DocumentCategory": "{Category}",
          "RequestDate": "now",
          "DueDate": "now+7d",
          "RequestStatus": "Requested",
          "InternalOwnerEmail": "hvcg_OpsEmail",
          "HVCG_IdempotencyKey": "docreq|{ClientCode}|{Title}"
        }
      }
    },
    {
      "id": 5,
      "action": "LogSuccess",
      "params": {
        "message": "created + skipped counts"
      }
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_ClientsSiteUrl",
    "hvcg_OpsEmail",
    "hvcg_ExecutiveEmail",
    "hvcg_EnableClientEmails"
  ]
}

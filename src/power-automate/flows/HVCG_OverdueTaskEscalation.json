{
  "flowName": "HVCG_OverdueTaskEscalation",
  "displayName": "HVCG_OverdueTaskEscalation",
  "description": "Marks overdue tasks and escalates per ladder; executive only when warranted.",
  "trigger": {
    "type": "Recurrence",
    "schedule": "Daily 07:30 America/Los_Angeles"
  },
  "connections": [
    "SharePoint",
    "Outlook",
    "Teams"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [],
  "steps": [
    {
      "id": 1,
      "action": "GetOpenPastDueTasks"
    },
    {
      "id": 2,
      "action": "SetIsOverdueTrue"
    },
    {
      "id": 3,
      "action": "NotifyOwner"
    },
    {
      "id": 4,
      "action": "EscalateToPMAfter3BusinessDays"
    },
    {
      "id": 5,
      "action": "EscalateToOpsIfCriticalBlocked"
    },
    {
      "id": 6,
      "action": "ExecutiveOnlyIfRuleMatch"
    },
    {
      "id": 7,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60,
    "notifyEmailEnv": "HVCG_OPS_EMAIL"
  },
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_CLIENTS_HUB_URL",
    "HVCG_OPS_EMAIL",
    "HVCG_EXECUTIVE_EMAIL",
    "HVCG_ENABLE_CLIENT_EMAILS"
  ],
  "owner": "HVCG Ops Automation",
  "defaultState": "Off",
  "documentationLink": "docs/automation/AUTOMATION_INVENTORY.md#hvcg_overduetaskescalation",
  "auditHistory": {
    "list": "HVCG_AutomationLogs",
    "required": true
  },
  "connectionReferences": [
    "hvcg_sharedsharepointonline",
    "hvcg_sharedoffice365",
    "hvcg_sharedteams"
  ],
  "rollbackOrDisable": "Turn Off in Maker; leave AutomationLogs intact",
  "usedByModules": [
    "Operations Hub"
  ],
  "execDashboardReleaseRole": "overdue escalations",
  "releaseSet": "executive-dashboard",
  "releaseStatus": "ReleaseCandidate",
  "productionChecklist": {
    "owner": true,
    "documentation": true,
    "retryHandling": true,
    "errorHandling": true,
    "notifications": true,
    "auditHistory": true,
    "connectionReferences": true,
    "environmentVariables": true,
    "makerUat": false,
    "qaGo": false,
    "productionEnabled": false
  }
}

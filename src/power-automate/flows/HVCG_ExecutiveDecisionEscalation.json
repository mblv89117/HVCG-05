{
  "flowName": "HVCG_ExecutiveDecisionEscalation",
  "displayName": "HVCG_ExecutiveDecisionEscalation",
  "description": "Notifies executive only for qualifying items.",
  "trigger": {
    "type": "SharePointItemModified",
    "condition": "RequiresExecutiveAttention eq true"
  },
  "connections": [
    "SharePoint",
    "Outlook",
    "Teams"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [],
  "steps": [
    {
      "id": 1,
      "action": "DeduplicateNotification24h"
    },
    {
      "id": 2,
      "action": "ComposeExecutiveBrief"
    },
    {
      "id": 3,
      "action": "EmailExecutive"
    },
    {
      "id": 4,
      "action": "CreateNotificationRow"
    },
    {
      "id": 5,
      "action": "LogSuccess"
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60,
    "notifyEmailEnv": "HVCG_OPS_EMAIL"
  },
  "environmentVariables": [
    "HVCG_SITE_URL",
    "HVCG_CLIENTS_HUB_URL",
    "HVCG_OPS_EMAIL",
    "HVCG_EXECUTIVE_EMAIL",
    "HVCG_ENABLE_CLIENT_EMAILS"
  ],
  "owner": "HVCG Ops Automation",
  "defaultState": "Off",
  "documentationLink": "docs/executive/FLOW_INTEGRATION.md",
  "auditHistory": {
    "list": "HVCG_AutomationLogs",
    "required": true
  },
  "connectionReferences": [
    "hvcg_sharedsharepointonline",
    "hvcg_sharedoffice365",
    "hvcg_sharedteams"
  ],
  "rollbackOrDisable": "Turn Off in Maker; leave AutomationLogs intact",
  "usedByModules": [
    "Executive Dashboard",
    "Executive Intelligence"
  ],
  "execDashboardReleaseRole": "Executive Brief / escalation",
  "releaseSet": "executive-dashboard",
  "releaseStatus": "ReleaseCandidate",
  "productionChecklist": {
    "owner": true,
    "documentation": true,
    "retryHandling": true,
    "errorHandling": true,
    "notifications": true,
    "auditHistory": true,
    "connectionReferences": true,
    "environmentVariables": true,
    "makerUat": false,
    "qaGo": false,
    "productionEnabled": false
  }
}

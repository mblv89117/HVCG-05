{
  "flowName": "HVCG_DeliverableApproval",
  "displayName": "HVCG_DeliverableApproval",
  "description": "Routes a deliverable through a Basic (internal) approval. On approve: DeliverableStatus=Approved (never auto-released/Delivered). On reject: DeliverableStatus=Revisions. Writes an HVCG_Approvals record and audit logs.",
  "trigger": {
    "type": "Manual",
    "inputs": [
      "DeliverableListItemId",
      "ApproverEmail"
    ]
  },
  "connections": [
    "SharePoint",
    "Approvals"
  ],
  "idempotency": {
    "strategy": "DeliverableStatusGuard",
    "onDuplicate": "SkippedDuplicate",
    "notes": "If DeliverableStatus already Approved or Delivered, log SkippedDuplicate and terminate."
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [
    {
      "connector": "Approvals",
      "operation": "StartAndWaitForAnApproval",
      "approvalType": "Basic",
      "assignedTo": "ApproverEmail | hvcg_ExecutiveEmail"
    }
  ],
  "steps": [
    {
      "id": 1,
      "action": "LogStarted"
    },
    {
      "id": 2,
      "action": "GetDeliverable",
      "params": {
        "list": "HVCG_Deliverables",
        "byId": "DeliverableListItemId"
      }
    },
    {
      "id": 3,
      "action": "GuardAlreadyApproved",
      "params": {
        "skipWhenStatusIn": [
          "Approved",
          "Delivered"
        ]
      }
    },
    {
      "id": 4,
      "action": "CreateApprovalRecord",
      "params": {
        "list": "HVCG_Approvals",
        "ApprovalType": "Deliverable",
        "ApprovalStatus": "Pending"
      }
    },
    {
      "id": 5,
      "action": "StartAndWaitForApproval",
      "params": {
        "approvalType": "Basic",
        "assignedTo": "ApproverEmail | hvcg_ExecutiveEmail"
      }
    },
    {
      "id": 6,
      "action": "OnApprove",
      "params": {
        "patch": {
          "list": "HVCG_Deliverables",
          "DeliverableStatus": "Approved",
          "ApproverEmail": "{approver}",
          "note": "Never sets Delivered/released"
        },
        "completeApproval": "Approved"
      }
    },
    {
      "id": 7,
      "action": "OnReject",
      "params": {
        "patch": {
          "list": "HVCG_Deliverables",
          "DeliverableStatus": "Revisions"
        },
        "completeApproval": "Rejected"
      }
    },
    {
      "id": 8,
      "action": "LogResult"
    }
  ],
  "notes": [
    "HVCG_Deliverables has no 'Released'/'In Revision'/'Rejected' choices; 'Approved' and 'Delivered' are treated as terminal for the guard, and 'Revisions' is used for rejection.",
    "Uses connection reference hvcg_sharedapprovals."
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_ClientsSiteUrl",
    "hvcg_OpsEmail",
    "hvcg_ExecutiveEmail",
    "hvcg_EnableClientEmails"
  ]
}

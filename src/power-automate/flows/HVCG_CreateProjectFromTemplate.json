{
  "flowName": "HVCG_CreateProjectFromTemplate",
  "displayName": "HVCG_CreateProjectFromTemplate",
  "description": "Creates a delivery project (ClientId lookup + ClientCode), 3 onboarding milestones and 3 onboarding tasks for a client. Idempotent per client/template/day via HVCG_IdempotencyKey.",
  "trigger": {
    "type": "ManualOrChild",
    "inputs": [
      "ClientCode",
      "ClientListItemId",
      "TemplateKey",
      "StartDate"
    ]
  },
  "connections": [
    "SharePoint"
  ],
  "idempotency": {
    "column": "HVCG_IdempotencyKey",
    "keyPattern": "proj|{ClientCode}|{TemplateKey}|{yyyyMMdd}",
    "onDuplicate": "SkippedDuplicate"
  },
  "logging": {
    "list": "HVCG_AutomationLogs",
    "onStart": true,
    "onSuccess": true,
    "onFailure": true
  },
  "humanApproval": [],
  "steps": [
    {
      "id": 1,
      "action": "LogStarted"
    },
    {
      "id": 2,
      "action": "ResolveClientId",
      "params": {
        "list": "HVCG_Clients",
        "byId": "ClientListItemId",
        "elseFilter": "ClientCode eq '{ClientCode}'"
      }
    },
    {
      "id": 3,
      "action": "ComputeIdempotencyKey",
      "params": {
        "pattern": "proj|{ClientCode}|{TemplateKey}|{yyyyMMdd}"
      }
    },
    {
      "id": 4,
      "action": "GetItemsByIdempotencyKey",
      "params": {
        "list": "HVCG_Projects",
        "onFoundLog": "SkippedDuplicate",
        "onFoundTerminate": "Succeeded"
      }
    },
    {
      "id": 5,
      "action": "CreateProject",
      "params": {
        "list": "HVCG_Projects",
        "fields": {
          "AtlasClientRefId": "{ClientId}",
          "ClientCode": "{ClientCode}",
          "ProjectTemplateKey": "{TemplateKey}",
          "ProjectStatus": "Not Started",
          "ProjectHealth": "Green",
          "StartDate": "{StartDate}",
          "TargetEndDate": "{StartDate}+21d",
          "HVCG_IdempotencyKey": "{key}"
        }
      }
    },
    {
      "id": 6,
      "action": "CreateMilestones",
      "params": {
        "list": "HVCG_Milestones",
        "items": [
          "Kickoff completed (+2d, critical)",
          "Critical documents received (+14d, critical)",
          "Onboarding complete (+21d)"
        ],
        "linkField": "ProjectIdId"
      }
    },
    {
      "id": 7,
      "action": "CreateTasks",
      "params": {
        "list": "HVCG_Tasks",
        "items": [
          "Schedule and run kickoff call (kickoff, +2d)",
          "Collect critical onboarding documents (collect-critical-docs, +7d, DependsOn kickoff)",
          "Complete onboarding review (onboarding-review, +21d, DependsOn collect-critical-docs)"
        ],
        "linkFields": [
          "AtlasClientRefId",
          "ProjectIdId"
        ]
      }
    },
    {
      "id": 8,
      "action": "LogSuccess",
      "params": {
        "message": "project id + milestone/task count"
      }
    }
  ],
  "errorHandling": {
    "notifyGroup": "HVCG-Role-Administrator",
    "maxRetries": 3,
    "retryDelaySeconds": 60
  },
  "environmentVariables": [
    "hvcg_CommandCenterSiteUrl",
    "hvcg_ClientsSiteUrl",
    "hvcg_OpsEmail",
    "hvcg_ExecutiveEmail",
    "hvcg_EnableClientEmails"
  ]
}

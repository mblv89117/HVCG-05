{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasSprint",
  "type": "object",
  "required": [
    "number",
    "name",
    "goals",
    "status"
  ],
  "properties": {
    "number": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "Planned",
        "Active",
        "Closed"
      ]
    },
    "capacityHours": {
      "type": "number"
    },
    "velocityTarget": {
      "type": "number"
    },
    "taskIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

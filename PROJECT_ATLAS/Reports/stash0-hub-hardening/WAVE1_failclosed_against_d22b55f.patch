+/** Maps thrown Hub errors to the 400/401/403/404/409/412/422/503 JSON contract. */
+export function toHubErrorPayload(err: unknown): { status: number; body: Record<string, unknown> } {
+  if (err instanceof SyntaxError) {
+    return {
+      status: 400,
+      body: {
+        error: 'malformed_json',
+        code: 'malformed_json',
+        message: 'Request body is not valid JSON',
       },
-      origin,
-    );
+    };
   }
+  const status = (err as { status?: number }).status || 500;
+  const thrownCode = typeof (err as { code?: unknown }).code === 'string' ? (err as { code: string }).code : undefined;
+  const error =
+    status === 401
+      ? 'unauthorized'
+      : status === 403
+        ? 'forbidden'
+        : status === 400
+          ? thrownCode || 'malformed_json'
+          : status === 404
+            ? thrownCode || 'not_found'
+            : status === 409
+              ? thrownCode || 'conflict'
+              : status === 412
+                ? thrownCode || 'precondition_failed'
+                : status === 422
+                  ? thrownCode || 'unprocessable'
+                  : status === 413
+                    ? thrownCode || 'payload_too_large'
+                    : status === 501
+                      ? thrownCode || 'not_implemented'
+                      : status === 503
+                        ? thrownCode || 'unavailable'
+                        : 'server_error';
+  return {
+    status,
+    body: {
+      error,
+      code: thrownCode || error,
+      message: status < 500 || status === 503 ? (err as Error).message : 'Internal error',
+    },
+  };
 }

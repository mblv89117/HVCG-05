# HVCG Project Management System — Environment Variables
# Copy to .env and fill values locally. Never commit .env.

# Tenant
HVCG_TENANT_ID=
HVCG_TENANT_DOMAIN=highvaluecapitalgroup.com

# SharePoint
HVCG_SITE_URL=https://<tenant>.sharepoint.com/sites/HVCG-CommandCenter
HVCG_CLIENTS_HUB_URL=https://<tenant>.sharepoint.com/sites/HVCG-Clients
HVCG_KNOWLEDGE_URL=https://<tenant>.sharepoint.com/sites/HVCG-Knowledge

# Entra / Graph (app registration — prefer certificate auth)
HVCG_GRAPH_CLIENT_ID=
HVCG_GRAPH_CERTIFICATE_THUMBPRINT=
# HVCG_GRAPH_CLIENT_SECRET=   # Prefer certificate; use secret only if required

# Service account (UPN) — used for Flow ownership and provisioning
HVCG_SERVICE_ACCOUNT_UPN=hvcg-ops@<tenant>.onmicrosoft.com

# Power Platform
HVCG_POWER_ENV_DEV=
HVCG_POWER_ENV_PROD=
HVCG_POWER_APPS_APP_ID=

# Notifications
HVCG_OPS_EMAIL=operations@<tenant>.onmicrosoft.com
HVCG_EXECUTIVE_EMAIL=manny@<tenant>.onmicrosoft.com
HVCG_ESCALATION_TEAMS_WEBHOOK=

# Feature flags
HVCG_ENABLE_CLIENT_EMAILS=false
HVCG_ENABLE_PREMIUM_CONNECTORS=false
HVCG_ENVIRONMENT=dev
